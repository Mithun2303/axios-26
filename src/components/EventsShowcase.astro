---
import Icon from './Icon.astro';
import { events } from '../data/events';

const cat = (c: string) => (c === 'Technical' ? 'tech' : c === 'Gaming' ? 'game' : 'nontech');
const filters = ['All', 'Technical', 'Non Technical', 'Gaming'];
---

<section class="lineup" id="lineup">
	<div class="container">
		<div class="lineup-head" data-reveal="fade">
			<p class="eyebrow">The Lineup</p>
			<h2 class="section-title">Ten arenas. <em>One clock.</em></h2>
			<p class="lede">Ten sealed dossiers. Each one stays closed until you are — open an arena for its
				rounds, its exact hour, and the prize riding on it.</p>

			<div class="filters" role="tablist" aria-label="Filter events by category">
				{filters.map((f, i) => (
					<button class="filter-chip" data-filter={f} aria-pressed={i === 0 ? 'true' : 'false'}>{f}</button>
				))}
			</div>
		</div>

		<div class="wheel-stage" data-reveal="scale">
			<div class="wheel-rings" aria-hidden="true">
				<span class="wheel-ring wheel-ring-1"></span>
				<span class="wheel-ring wheel-ring-2"></span>
			</div>
			<div class="wheel-hand" aria-hidden="true"></div>
			<div class="wheel-hub" aria-hidden="true">
				<Icon name="hourglass" />
				<span>{events.length} Arenas</span>
			</div>

			<div class="wheel-positions">
				{events.map((ev, i) => (
					<button
						type="button"
						id={`event-${ev.key}`}
						class:list={['ev-card', 'wheel-pos', cat(ev.category)]}
						data-cat={ev.category}
						data-target={`dossier-${ev.key}`}
						style={`--angle:${(i / events.length) * 360}deg; --flare-delay:${(-(i / events.length) * 48).toFixed(2)}s`}
						aria-haspopup="dialog"
						aria-controls={`dossier-${ev.key}`}
					>
						<span class="wheel-pos-glow" aria-hidden="true"></span>
						<div class="ev-card-seal"><img src={ev.logo} alt={ev.name} loading="lazy" /></div>
						{ev.signature && (
							<span class="wheel-pos-sig" title="Signature Event"><Icon name="laurel" /></span>
						)}
						<span class="wheel-pos-label">
							<strong>{ev.name}</strong>
							<em>{ev.tag}</em>
							<b><Icon name="coin" /> {ev.prize}</b>
						</span>
					</button>
				))}
			</div>
		</div>
	</div>

	{events.map((ev) => (
		<dialog class="dossier-modal" id={`dossier-${ev.key}`} aria-labelledby={`dossier-${ev.key}-title`}>
			<div class="modal-panel">
				<button type="button" class="modal-close" aria-label="Close dossier"><Icon name="close" /></button>

				<div class="d-head">
					<div class="d-emblem-ring"><img src={ev.logo} alt={ev.name} loading="lazy" /></div>
					<div class="d-head-text">
						{ev.signature && <span class="d-signature">Signature Event</span>}
						<span class="d-tag">{ev.tag}</span>
						<h3 id={`dossier-${ev.key}-title`}>{ev.name}</h3>
						<div class="d-meta">
							<span class="tag-chip">{ev.category}</span>
							<span class="tag-chip"><Icon name="joystick" /> {ev.teamSize}</span>
							<span class="tag-chip prize"><Icon name="coin" /> {ev.prize}</span>
						</div>
					</div>
				</div>

				<p class="d-about">{ev.about}</p>

				<div class="d-grid">
					<div class="d-rounds">
						<h4><Icon name="scroll" /> Rounds</h4>
						<ol>
							{ev.rounds.map((r) => (
								<li><strong>{r.t}</strong><span>{r.d}</span></li>
							))}
						</ol>
					</div>

					<div class="d-side">
						<div class="d-timeline">
							<h4><Icon name="hourglass" /> Timeline</h4>
							<ul>
								{ev.timeline.map((t) => (
									<li>
										<span class="d-tl-round">{t.r}</span>
										<span class="d-tl-day">{t.day}</span>
										<span class="d-tl-time num">{t.time}</span>
										<span class="d-tl-loc">{t.loc}</span>
									</li>
								))}
							</ul>
						</div>

						{ev.splits.length > 0 && (
							<div class="d-splits">
								<h4><Icon name="trophy" /> Prize Split</h4>
								{ev.splits.map((s) => (
									<div class="split-row">
										<span class="split-p">{s.p}</span>
										<div class="split-bar"><div class="split-fill" style={`--w:${s.w}%`}></div></div>
										<span class="split-a num">{s.a}</span>
									</div>
								))}
							</div>
						)}

						<div class="d-convenors">
							<h4><Icon name="quill" /> Convenors</h4>
							{ev.convenors.map((c) => (
								<span class="convenor">{c.n} <a href={`tel:${c.ph.replace(/\s/g, '')}`}>{c.ph}</a></span>
							))}
						</div>
					</div>
				</div>
			</div>
		</dialog>
	))}
</section>

<script>
	const dialogs = new Map<string, HTMLDialogElement>();
	document.querySelectorAll<HTMLDialogElement>('.dossier-modal').forEach((d) => dialogs.set(d.id, d));

	const openDossier = (dialog: HTMLDialogElement) => {
		if (dialog.open) return;
		dialog.showModal();
		document.documentElement.classList.add('dossier-open');
		requestAnimationFrame(() => requestAnimationFrame(() => dialog.classList.add('is-open')));
	};

	const closeDossier = (dialog: HTMLDialogElement) => {
		if (!dialog.open) return;
		dialog.classList.remove('is-open');
		const panel = dialog.querySelector<HTMLElement>('.modal-panel');
		let done = false;
		const finish = () => {
			if (done) return;
			done = true;
			dialog.close();
			document.documentElement.classList.remove('dossier-open');
			// let the seal re-form on the triggering card, ready to be broken again
			document.querySelector(`.ev-card[data-target="${dialog.id}"]`)?.classList.remove('is-breaking');
		};
		panel?.addEventListener('transitionend', finish, { once: true });
		setTimeout(finish, 500);
	};

	// cracking the wax seal is a beat of its own before the dossier opens
	const breakSealThenOpen = (card: HTMLElement, dialog: HTMLDialogElement) => {
		if (card.classList.contains('is-breaking')) return;
		card.classList.add('is-breaking');
		setTimeout(() => openDossier(dialog), 360);
	};

	document.querySelectorAll<HTMLButtonElement>('.ev-card').forEach((card) => {
		card.addEventListener('click', () => {
			const target = card.dataset.target;
			const dialog = target ? dialogs.get(target) : undefined;
			if (dialog) breakSealThenOpen(card, dialog);
		});
	});

	dialogs.forEach((dialog) => {
		dialog.addEventListener('click', (e) => {
			if (e.target === dialog) closeDossier(dialog);
		});
		dialog.querySelector('.modal-close')?.addEventListener('click', () => closeDossier(dialog));
		dialog.addEventListener('cancel', (e) => {
			e.preventDefault();
			closeDossier(dialog);
		});
	});

	// orrery layout — positions are spread evenly around the dial, and the
	// sweeping hand's glow is timed via a matching negative animation-delay
	const ROTATE_SECONDS = 32;
	const wheelNodes = Array.from(document.querySelectorAll<HTMLElement>('.wheel-pos'));

	const layoutWheel = () => {
		const visible = wheelNodes.filter((n) => !n.classList.contains('is-hidden'));
		const total = visible.length || 1;
		visible.forEach((node, idx) => {
			const angle = (idx / total) * 360;
			node.style.setProperty('--angle', `${angle}deg`);
			node.style.setProperty('--flare-delay', `${(-(angle / 360) * ROTATE_SECONDS).toFixed(2)}s`);
		});
	};
	layoutWheel();

	// as the hand sweeps around, whichever node it's currently pointing at
	// gets its preview label shown automatically — no hover needed
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (!reduceMotion) {
		const sweepStart = performance.now();
		let activeNode: HTMLElement | null = null;

		const tickSweep = () => {
			const elapsed = (performance.now() - sweepStart) % (ROTATE_SECONDS * 1000);
			const handAngle = (elapsed / (ROTATE_SECONDS * 1000)) * 360;
			const visible = wheelNodes.filter((n) => !n.classList.contains('is-hidden'));

			let nearest: HTMLElement | null = null;
			let smallestDiff = Infinity;
			for (const node of visible) {
				const nodeAngle = parseFloat(node.style.getPropertyValue('--angle')) || 0;
				let diff = Math.abs(handAngle - nodeAngle);
				if (diff > 180) diff = 360 - diff;
				if (diff < smallestDiff) {
					smallestDiff = diff;
					nearest = node;
				}
			}

			// only "point at" a node once the hand is genuinely close to it
			const pointingAt = nearest && smallestDiff < 14 ? nearest : null;
			if (pointingAt !== activeNode) {
				activeNode?.classList.remove('is-active');
				pointingAt?.classList.add('is-active');
				activeNode = pointingAt;
			}
			requestAnimationFrame(tickSweep);
		};
		requestAnimationFrame(tickSweep);
	}

	// filters
	const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
	chips.forEach((chip) => {
		chip.addEventListener('click', () => {
			chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
			chip.setAttribute('aria-pressed', 'true');
			const f = chip.dataset.filter;
			wheelNodes.forEach((node) => {
				const show = f === 'All' || node.dataset.cat === f;
				node.classList.toggle('is-hidden', !show);
				(node as HTMLButtonElement).inert = !show;
			});
			layoutWheel();
		});
	});

	// deep links from elsewhere (e.g. #event-tri) scroll to the card and open its dossier
	const openFromHash = () => {
		const id = location.hash.slice(1);
		if (!id) return;
		const card = document.getElementById(id);
		if (!card || !card.classList.contains('ev-card')) return;
		card.scrollIntoView({ block: 'center', behavior: 'smooth' });
		card.classList.add('pulse');
		setTimeout(() => card.classList.remove('pulse'), 1500);
		const target = (card as HTMLElement).dataset.target;
		const dialog = target ? dialogs.get(target) : undefined;
		if (dialog) setTimeout(() => breakSealThenOpen(card as HTMLElement, dialog), 550);
	};
	if (location.hash) openFromHash();
	window.addEventListener('hashchange', openFromHash);
</script>

<style>
	.lineup {
		padding: 8rem 0 4rem;
		position: relative;
		background: radial-gradient(ellipse 70% 40% at 50% 0%, rgba(63, 174, 116, 0.06), transparent 60%);
	}

	.lineup-head {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.1rem;
		margin-bottom: 4rem;
	}

	.filters {
		display: flex;
		gap: 0.6rem;
		flex-wrap: wrap;
		justify-content: center;
		margin-top: 0.8rem;
	}

	.filter-chip {
		font-family: var(--font-body);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 0.55em 1.1em;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: transparent;
		color: var(--ink-dim);
		cursor: pointer;
		transition: all 0.3s var(--ease-out);
	}

	.filter-chip[aria-pressed='true'] {
		background: var(--gold);
		border-color: var(--gold);
		color: var(--void);
		font-weight: 600;
	}

	/* --- orrery: events arranged as hour-marks around a slowly turning dial --- */
	.wheel-stage {
		position: relative;
		width: min(620px, 88vw);
		height: min(620px, 88vw);
		margin: 0 auto;
		/* radius tuned to sit exactly on chrono.png's outer diamond-spike ring */
		--wheel-r: min(235px, 33.3vw);
		border-radius: 50%;
		background: radial-gradient(circle, rgba(5, 8, 6, 0.25) 0%, rgba(5, 8, 6, 0.7) 100%), url('/chrono.png') center / cover no-repeat;
		box-shadow: 0 0 70px rgba(0, 0, 0, 0.55), inset 0 0 90px rgba(0, 0, 0, 0.6);
	}

	.wheel-rings {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.wheel-ring {
		position: absolute;
		top: 50%;
		left: 50%;
		border-radius: 50%;
		border: 1px solid var(--line);
		transform: translate(-50%, -50%);
	}

	.wheel-ring-1 {
		width: calc(var(--wheel-r) * 2);
		height: calc(var(--wheel-r) * 2);
	}

	.wheel-ring-2 {
		/* matches the dotted mid ring in chrono.png */
		width: calc(var(--wheel-r) * 1.47);
		height: calc(var(--wheel-r) * 1.47);
		opacity: 0.5;
	}

	.wheel-hand {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 2px;
		height: var(--wheel-r);
		background: linear-gradient(to top, var(--gold-bright), transparent 85%);
		transform-origin: 50% 100%;
		transform: translate(-50%, -100%) rotate(0deg);
		animation: wheel-hand-sweep 32s linear infinite;
		filter: drop-shadow(0 0 6px var(--gold));
		z-index: 1;
		pointer-events: none;
	}

	@keyframes wheel-hand-sweep {
		to {
			transform: translate(-50%, -100%) rotate(360deg);
		}
	}

	.wheel-hub {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: clamp(72px, 12vw, 112px);
		height: clamp(72px, 12vw, 112px);
		border-radius: 50%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.3rem;
		background: radial-gradient(circle at 35% 30%, rgba(30, 26, 16, 0.9), rgba(10, 8, 5, 0.95));
		border: 1px solid var(--gold-dim);
		box-shadow: 0 0 30px rgba(201, 154, 63, 0.15), inset 0 0 20px rgba(0, 0, 0, 0.5);
		z-index: 2;
		pointer-events: none;
		color: var(--gold);
	}

	.wheel-hub .icon {
		font-size: 1.6rem;
	}

	.wheel-hub span {
		font-family: var(--font-display);
		font-size: 0.58rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.wheel-positions {
		position: absolute;
		inset: 0;
	}

	.ev-card {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 5rem;
		height: 5rem;
		text-align: left;
		font-family: inherit;
		color: inherit;
		cursor: pointer;
		appearance: none;
		border: none;
		background: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		transform: translate(-50%, -50%) rotate(var(--angle, 0deg)) translate(0, calc(-1 * var(--wheel-r, 200px)))
			rotate(calc(-1 * var(--angle, 0deg)));
		transition: transform 0.7s var(--ease-out), opacity 0.5s var(--ease-out);
		z-index: 3;
	}

	.ev-card:focus-visible {
		outline: 2px solid var(--gold);
		outline-offset: 4px;
		border-radius: 50%;
	}

	.ev-card.is-hidden {
		opacity: 0;
		transform: translate(-50%, -50%) scale(0.15);
		pointer-events: none;
	}

	.wheel-pos-glow {
		position: absolute;
		inset: -8px;
		border-radius: 50%;
		background: radial-gradient(circle, var(--accent, var(--gold)) 0%, transparent 70%);
		opacity: 0;
		filter: blur(2px);
		animation: wheel-flare 32s linear infinite;
		animation-delay: var(--flare-delay, 0s);
		pointer-events: none;
		z-index: 0;
	}

	@keyframes wheel-flare {
		0%,
		90%,
		100% {
			opacity: 0;
			transform: scale(0.8);
		}
		95% {
			opacity: 0.9;
			transform: scale(1.3);
		}
	}

	.wheel-pos-sig {
		position: absolute;
		top: -4px;
		right: -4px;
		width: 1.3rem;
		height: 1.3rem;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: linear-gradient(120deg, var(--gold), var(--future));
		color: var(--void);
		font-size: 0.65rem;
		box-shadow: 0 0 8px rgba(201, 154, 63, 0.6);
		z-index: 3;
	}

	.wheel-pos-label {
		position: absolute;
		top: 100%;
		left: 50%;
		transform: translate(-50%, 0.4rem) scale(0.94);
		white-space: nowrap;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.2rem;
		padding: 0.6rem 0.9rem;
		border: 1px solid var(--gold-dim);
		border-radius: 10px;
		background: linear-gradient(160deg, rgba(24, 20, 12, 0.96), rgba(10, 8, 5, 0.98));
		box-shadow: 0 12px 28px -12px rgba(0, 0, 0, 0.7);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s var(--ease-out), transform 0.3s var(--ease-out);
		z-index: 5;
	}

	.wheel-pos-label strong {
		font-family: var(--font-display);
		font-size: 0.85rem;
		color: var(--ink);
	}

	.wheel-pos-label em {
		font-style: normal;
		font-size: 0.6rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent, var(--gold));
	}

	.wheel-pos-label b {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		font-weight: 400;
		font-family: var(--font-display);
		font-size: 0.72rem;
		color: var(--gold-bright);
		margin-top: 0.1rem;
	}

	.ev-card:hover .wheel-pos-label,
	.ev-card:focus-visible .wheel-pos-label,
	.ev-card.is-active .wheel-pos-label {
		opacity: 1;
		transform: translate(-50%, 0.6rem) scale(1);
	}

	/* the node the hand is currently pointing at gets a quiet spotlight too */
	.ev-card.is-active .ev-card-seal {
		transform: scale(1.12) rotate(-4deg);
	}

	.ev-card.is-active .wheel-pos-label {
		z-index: 6;
	}

	.ev-card.tech {
		--accent: var(--gold);
	}

	.ev-card.nontech {
		--accent: var(--future-2);
	}

	.ev-card.game {
		--accent: var(--ember);
	}

	.ev-card.pulse {
		animation: card-pulse 1.4s var(--ease-out);
	}

	@keyframes card-pulse {
		0% {
			box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent, var(--gold)) 55%, transparent);
		}
		65% {
			box-shadow: 0 0 0 16px transparent;
		}
		100% {
			box-shadow: 0 0 0 0 transparent;
		}
	}

	/* wax seal — the icon is stamped into it until the card is clicked */
	.ev-card-seal {
		position: relative;
		width: 3.4rem;
		height: 3.4rem;
		display: grid;
		place-items: center;
		margin-top: 0.4rem;
		font-size: 1.5rem;
		transition: transform 0.4s var(--ease-out);
	}

	.ev-card-seal img {
		position: relative;
		z-index: 1;
		width: 62%;
		height: 62%;
		object-fit: contain;
		border-radius: 50%;
		filter: brightness(0.85) saturate(0.8);
		transition: filter 0.35s var(--ease-out) 0.1s;
	}

	.ev-card-seal::before,
	.ev-card-seal::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 28%, color-mix(in srgb, var(--accent, var(--gold)) 65%, white 20%), color-mix(in srgb, var(--accent, var(--gold)) 80%, black 20%));
		box-shadow: inset 0 -3px 5px rgba(0, 0, 0, 0.35), inset 0 2px 2px rgba(255, 255, 255, 0.2), 0 3px 8px rgba(0, 0, 0, 0.4);
		transition: transform 0.4s var(--ease-out), opacity 0.4s var(--ease-out);
	}

	.ev-card-seal::before {
		clip-path: polygon(0 0, 100% 0, 100% 47%, 0 53%);
	}

	.ev-card-seal::after {
		clip-path: polygon(0 53%, 100% 47%, 100% 100%, 0 100%);
	}

	.ev-card:hover .ev-card-seal,
	.ev-card:focus-visible .ev-card-seal {
		transform: scale(1.06) rotate(-4deg);
	}

	.ev-card.is-breaking .ev-card-seal::before {
		transform: translate(-10px, -8px) rotate(-20deg);
		opacity: 0;
	}

	.ev-card.is-breaking .ev-card-seal::after {
		transform: translate(10px, 8px) rotate(16deg);
		opacity: 0;
	}

	.ev-card.is-breaking .ev-card-seal img {
		filter: brightness(1.15) saturate(1);
	}

	/* --- dossier modal --- */
	:global(html.dossier-open) {
		overflow: hidden;
	}

	.dossier-modal {
		border: none;
		padding: 0;
		background: transparent;
		color: inherit;
		max-width: min(880px, 92vw);
		width: 100%;
		max-height: 86vh;
		overflow: visible;
	}

	.dossier-modal::backdrop {
		background: rgba(5, 8, 6, 0.78);
		backdrop-filter: blur(8px);
	}

	.modal-panel {
		position: relative;
		container-type: inline-size;
		container-name: dossier;
		max-height: 86vh;
		overflow-y: auto;
		padding: clamp(1.8rem, 4vw, 3rem);
		border: 1px solid var(--gold-dim);
		border-radius: var(--radius);
		background: linear-gradient(160deg, rgba(20, 21, 42, 0.97), rgba(8, 9, 18, 0.98));
		opacity: 0;
		transform: translateY(28px) scale(0.96);
		transition: opacity 0.45s var(--ease-out), transform 0.5s var(--ease-out);
	}

	.dossier-modal.is-open .modal-panel {
		opacity: 1;
		transform: translateY(0) scale(1);
	}

	.modal-panel > *:not(.modal-close) {
		opacity: 0;
		transform: translateY(14px);
		transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out);
	}

