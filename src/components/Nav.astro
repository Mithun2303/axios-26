---
import Icon from './Icon.astro';
const REG_URL = 'https://proleap.ewhizard.tech/join/EvB_iLQ2bm';
const links = [
	{ href: '#legacy', label: 'Legacy' },
	{ href: '#schedule', label: 'Schedule' },
	{ href: '#lineup', label: 'Lineup' },
	{ href: '#voices', label: 'Voices' },
	{ href: '#prizes', label: 'Prizes' },
	{ href: '#sponsors', label: 'Sponsors' },
	{ href: '#help', label: 'Help' },
];
---

<header class="nav" id="site-nav">
	<div class="nav-inner container">
		<a href="#top" class="brand">
			<span class="brand-mark" aria-hidden="true">
				<img src="/logo-chronos-mark.png" alt="" />
			</span>
			<span class="brand-text">
				<strong>AXIOS</strong><span>'26</span>
			</span>
			<span class="brand-status" aria-hidden="true"><i class="led led-on"></i>sys // online</span>
		</a>

		<nav class="links" aria-label="Primary">
			{links.map((l) => (
				<a href={l.href}>{l.label}</a>
			))}
		</nav>

		<a class="btn nav-cta" href={REG_URL} target="_blank" rel="noopener">
			register <Icon name="arrow-right" />
		</a>

		<button class="burger" id="burger" aria-label="Toggle menu" aria-expanded="false">
			<span></span><span></span><span></span>
		</button>
	</div>

	<div class="mobile-panel" id="mobile-panel">
		{links.map((l) => (
			<a href={l.href}>{l.label}</a>
		))}
		<a class="btn" href={REG_URL} target="_blank" rel="noopener">register <Icon name="arrow-right" /></a>
	</div>
</header>

<script>
	const nav = document.getElementById('site-nav');
	const onScroll = () => {
		if (window.scrollY > 40) nav?.classList.add('scrolled');
		else nav?.classList.remove('scrolled');
	};
	document.addEventListener('scroll', onScroll, { passive: true });
	onScroll();

	const burger = document.getElementById('burger');
	const panel = document.getElementById('mobile-panel');
	burger?.addEventListener('click', () => {
		const open = panel?.classList.toggle('open');
		burger.setAttribute('aria-expanded', open ? 'true' : 'false');
	});
	panel?.querySelectorAll('a').forEach((a) =>
		a.addEventListener('click', () => {
			panel.classList.remove('open');
			burger?.setAttribute('aria-expanded', 'false');
		})
	);
</script>

<style>
	.nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		padding: 1.5rem 0 0;
		transition: padding 0.4s var(--ease-out);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		padding-top: 0.7rem;
		padding-bottom: 0.7rem;
		padding-left: 1.1rem;
		padding-right: 0.6rem;
		border-radius: var(--radius);
		border: 1px solid transparent;
		transition: border-color 0.4s var(--ease-out), background 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
	}

	.nav.scrolled {
		padding-top: 0.9rem;
	}

	.nav.scrolled .nav-inner {
		background: rgba(5, 8, 6, 0.82);
		backdrop-filter: blur(16px) saturate(140%);
		border-color: var(--line);
		box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-family: var(--font-display);
	}

	.brand-mark {
		width: 34px;
		height: 34px;
		display: grid;
		place-items: center;
		padding: 4px;
		border: 1px solid var(--line-bright);
		border-radius: var(--radius);
	}

	.brand-mark img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		animation: spin-slow 24s linear infinite;
	}

	.brand-text strong {
		letter-spacing: 0.02em;
		font-size: 1.1rem;
		font-weight: 700;
	}

	.brand-text span {
		color: var(--gold);
		margin-left: 0.25em;
		font-family: var(--font-mono);
	}

	.brand-status {
		display: flex;
		align-items: center;
		gap: 0.4em;
		font-family: var(--font-mono);
		font-size: 0.64rem;
		letter-spacing: 0.14em;
		color: var(--ink-faint);
		padding-left: 0.6rem;
		margin-left: 0.2rem;
		border-left: 1px solid var(--line);
	}

	@media (max-width: 1200px) {
		.brand-status {
			display: none;
		}
	}

	.links {
		display: flex;
		gap: 1.5rem;
		font-family: var(--font-body);
		font-size: 0.76rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.links a {
		position: relative;
		opacity: 0.8;
		transition: opacity 0.3s;
	}

	.links a::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: -6px;
		width: 0;
		height: 1px;
		background: var(--gold);
		transition: width 0.3s var(--ease-out);
	}

	.links a:hover {
		opacity: 1;
	}

	.links a:hover::after {
		width: 100%;
	}

	.nav-cta {
		padding: 0.6em 1.3em;
		font-size: 0.75rem;
	}

	.burger {
		display: none;
		flex-direction: column;
		gap: 5px;
		background: none;
		border: 0;
		padding: 8px;
		cursor: pointer;
	}

	.burger span {
		width: 22px;
		height: 2px;
		background: var(--ink);
		transition: transform 0.3s, opacity 0.3s;
	}

	.mobile-panel {
		display: none;
	}

	@media (max-width: 1000px) {
		.links,
		.nav-cta {
			display: none;
		}

		.burger {
			display: flex;
		}

		.mobile-panel {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
			margin: 0.6rem 1.25rem 0;
			padding: 1rem 1.25rem;
			background: rgba(5, 8, 6, 0.95);
			backdrop-filter: blur(16px);
			border: 1px solid var(--line);
			border-radius: var(--radius);
			max-height: 0;
			overflow: hidden;
			opacity: 0;
			transition: max-height 0.4s var(--ease-out), opacity 0.3s;
		}

		.mobile-panel.open {
			max-height: 400px;
			opacity: 1;
			padding-bottom: 1.4rem;
		}

		.mobile-panel a {
			padding: 0.7rem 0;
			font-size: 0.95rem;
			border-bottom: 1px solid var(--line);
		}

		.mobile-panel .btn {
			margin-top: 0.8rem;
			justify-content: center;
		}
	}
</style>
