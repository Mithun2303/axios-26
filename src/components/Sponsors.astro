---
const previous = [
	{ name: 'Wavicle Data Solutions', logo: null },
	{ name: 'Foxsense Innovations', logo: null },
	{ name: 'The Cloud Company', logo: null },
	{ name: 'Shankar IAS Academy', logo: null },
	{ name: 'Zee Taurus', logo: null },
	{ name: 'Triumph Hub', logo: null },
	{ name: 'Frozen Stick', logo: null },
	{ name: 'Speed Step', logo: null },
];
---

<section class="sponsors" id="sponsors">
	<div class="container">
		<div class="sp-head" data-reveal="fade">
			<p class="eyebrow">Partners</p>
			<h2 class="section-title">Backed across <em>every era</em></h2>
		</div>

		<div class="sp-titles">
			<div class="sp-title-card" data-reveal="left">
				<span class="sp-kicker">Title Sponsor</span>
				<img class="sp-logo" src="/assets/arcesium-logo.webp" alt="Arcesium" loading="lazy" />
			</div>
			<div class="sp-title-card alt" data-reveal="right">
				<span class="sp-kicker">Title Co-Sponsor</span>
				<img class="sp-logo" src="/assets/kla-logo.webp" alt="KLA" loading="lazy" />
			</div>
		</div>

		<div class="sp-prev" data-reveal="fade">
			<span class="sp-prev-label">Previous Editions Trusted Us</span>
			<div class="sp-ticker-wrap">
				<div class="sp-ticker">
					{[...previous, ...previous].map((s) => (
						s.logo ? <img class="sp-ticker-logo" src={s.logo} alt={s.name} loading="lazy" /> : <span>{s.name}</span>
					))}
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.sponsors {
		padding: 6rem 0;
		background: linear-gradient(180deg, var(--void), var(--deep-2));
	}

	.sp-head {
		text-align: center;
		margin-bottom: 3rem;
	}

	.sp-titles {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
		max-width: 760px;
		margin: 0 auto 3.5rem;
	}

	.sp-title-card {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		padding: 2.4rem 1.5rem;
		border: 1px solid var(--gold-dim);
		border-radius: var(--radius);
		text-align: center;
		background: linear-gradient(160deg, rgba(201, 154, 63, 0.08), transparent);
	}

	.sp-title-card.alt {
		border-color: color-mix(in srgb, var(--future-2) 45%, transparent);
		background: linear-gradient(160deg, rgba(63, 174, 116, 0.08), transparent);
	}

	.sp-kicker {
		font-size: 0.68rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.sp-logo {
		max-width: 220px;
		max-height: 4.5rem;
		width: auto;
		height: auto;
		object-fit: contain;
	}

	.sp-prev {
		text-align: center;
	}

	.sp-prev-label {
		display: block;
		font-size: 0.72rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--ink-faint);
		margin-bottom: 1.4rem;
	}

	.sp-ticker-wrap {
		overflow: hidden;
		position: relative;
		mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
	}

	.sp-ticker {
		display: flex;
		width: max-content;
		gap: 3.5rem;
		animation: marquee 26s linear infinite reverse;
	}

	.sp-ticker-wrap:hover .sp-ticker {
		animation-play-state: paused;
	}

	.sp-ticker span {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 1.15rem;
		color: var(--ink-faint);
		white-space: nowrap;
	}

	.sp-ticker-logo {
		max-height: 2.2rem;
		width: auto;
		object-fit: contain;
		opacity: 0.75;
		filter: grayscale(1) brightness(1.6);
		transition: opacity 0.3s, filter 0.3s;
	}

	.sp-ticker-logo:hover {
		opacity: 1;
		filter: none;
	}

	@media (max-width: 620px) {
		.sp-titles {
			grid-template-columns: 1fr;
		}
	}
</style>
