<script>
  /* =========================================================
     COUNTDOWN
     ========================================================= */

  const el = document.querySelector<HTMLElement>(".countdown");

  if (el) {
    const target = new Date(el.dataset.target || "").getTime();

    const nums: Record<"d" | "h" | "m" | "s", HTMLElement | null> = {
      d: el.querySelector('[data-unit="d"]'),
      h: el.querySelector('[data-unit="h"]'),
      m: el.querySelector('[data-unit="m"]'),
      s: el.querySelector('[data-unit="s"]'),
    };

    const pad = (n: number) => String(Math.max(0, n)).padStart(2, "0");

    const setUnit = (unit: keyof typeof nums, value: string) => {
      const node = nums[unit];

      if (!node || node.textContent === value) {
        return;
      }

      node.textContent = value;

      node.classList.remove("cd-num-tick");

      void node.offsetWidth;

      node.classList.add("cd-num-tick");
    };

    const tick = () => {
      const diff = target - Date.now();

      if (diff <= 0) {
        (["d", "h", "m", "s"] as const).forEach((u) => {
          setUnit(u, "00");
        });

        return;
      }

      const d = Math.floor(diff / 86400000);

      const h = Math.floor((diff % 86400000) / 3600000);

      const m = Math.floor((diff % 3600000) / 60000);

      const s = Math.floor((diff % 60000) / 1000);

      setUnit("d", pad(d));
      setUnit("h", pad(h));
      setUnit("m", pad(m));
      setUnit("s", pad(s));
    };

    tick();

    setInterval(tick, 1000);
  }
</script>

<style>
  /* =========================================================
     HERO
     ========================================================= */

  .hero {
    position: relative;

    min-height: 100svh;

    display: flex;
    flex-direction: column;

    justify-content: center;

    overflow: hidden;

    padding-top: 6rem;

    background-color: var(--void);

    background-image:
      radial-gradient(
        ellipse 60% 45% at 50% 18%,
        rgba(63, 174, 116, 0.16),
        transparent 60%
      ),
      radial-gradient(
        ellipse 50% 40% at 85% 75%,
        rgba(201, 154, 63, 0.1),
        transparent 60%
      ),
      linear-gradient(
        180deg,
        rgba(5, 8, 6, 0.45) 0%,
        rgba(7, 13, 9, 0.75) 55%,
        var(--deep-2) 100%
      ),
      url("/Chronos-bg.png");

    background-size: auto, auto, auto, cover;

    background-position:
      center,
      center,
      center,
      center 28%;

    background-repeat: no-repeat;
  }

  /* =========================================================
     BACKGROUND
     ========================================================= */

  .hero-bg {
    position: absolute;
    inset: 0;

    z-index: 0;
  }

  .starfield {
    position: absolute;
    inset: 0;

    background-image:
      radial-gradient(1.5px 1.5px at 12% 22%, #fff8 50%, transparent),
      radial-gradient(1.5px 1.5px at 82% 15%, #fff6 50%, transparent),
      radial-gradient(1px 1px at 32% 68%, #fff9 50%, transparent),
      radial-gradient(1.5px 1.5px at 62% 40%, #fff5 50%, transparent),
      radial-gradient(1px 1px at 92% 60%, #fff7 50%, transparent),
      radial-gradient(1.5px 1.5px at 22% 85%, #fff6 50%, transparent),
      radial-gradient(1px 1px at 48% 12%, #fff8 50%, transparent),
      radial-gradient(1.5px 1.5px at 72% 90%, #fff5 50%, transparent);

    opacity: 0.7;
  }

  .ring {
    position: absolute;

    border-radius: 50%;

    border: 1px solid var(--line);

    opacity: 0.5;
  }

  .ring-a {
    width: 900px;
    height: 900px;

    top: -20%;
    left: 50%;

    transform: translateX(-50%);

    border-style: dashed;
  }

  .ring-b {
    width: 620px;
    height: 620px;

    top: -8%;
    left: 50%;

    transform: translateX(-50%);

    border-color: color-mix(in srgb, var(--future) 40%, transparent);
  }

  /* =========================================================
     HERO PROPS
     ========================================================= */

  .hero-props {
    position: absolute;
    inset: 0;

    z-index: 1;

    opacity: 0;

    animation: propsIn 1.2s var(--ease-out) 0.3s forwards;
  }

  .hero-props .prop {
    width: var(--size);
    height: var(--size);

    font-size: var(--size);
  }

  .spin-slow {
    animation: spin-slow 22s linear infinite;
  }

  .spin-slow-rev {
    animation: spin-slow-rev 26s linear infinite;
  }

  .drift {
    animation: drift 7s ease-in-out infinite;
  }

  .drift-slow {
    animation: drift 10s ease-in-out infinite 1s;
  }

  /* =========================================================
     HERO CONTENT
     ========================================================= */

  .hero-content {
    position: relative;

    z-index: 2;

    display: flex;
    flex-direction: column;

    align-items: center;

    text-align: center;

    gap: 0.7rem;

    width: 100%;
  }

  /* =========================================================
     HERO MARK
     ========================================================= */

  .hero-mark {
    position: relative;

    display: grid;

    place-items: center;

    width: clamp(56px, 6.5vw, 78px);

    aspect-ratio: 1076 / 1556;

    margin: 0 auto 0.2rem;

    pointer-events: none;
  }

  .hero-mark-img {
    position: relative;

    z-index: 2;

    width: 100%;
    height: auto;

    filter: drop-shadow(0 0 20px rgba(63, 174, 116, 0.35))
      drop-shadow(0 0 5px rgba(201, 154, 63, 0.3));
  }

  .hero-mark-glow {
    position: absolute;

    inset: -40%;

    border-radius: 50%;

    background: radial-gradient(
      circle,
      rgba(63, 174, 116, 0.25),
      transparent 70%
    );

    animation: pulse-glow 3.2s ease-in-out infinite;
  }

  /* =========================================================
     REVEAL
     ========================================================= */

  .reveal-seq {
    opacity: 0;

    transform: translateY(18px);

    animation: seqIn 0.7s var(--ease-out) forwards;

    animation-delay: var(--d, 0s);
  }

  @keyframes seqIn {
    to {
      opacity: 1;

      transform: translateY(0);
    }
  }

  @keyframes propsIn {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  /* =========================================================
     TITLE
     ========================================================= */

  .title {
    display: flex;

    flex-direction: column;

    align-items: center;

    line-height: 0.95;
  }

  /* =========================================================
     AXIOS '26 — CINZEL
     ========================================================= */

  .axios-odometer,
  .odo-letter,
  .odo-strip,
  .odo-strip > span,
  .odo-year {
    font-family: "Cinzel", serif !important;
    font-weight: 700 !important;
    font-style: normal;
  }

  .line1 {
    font-family: "Cinzel", serif !important;
    font-weight: 700 !important;
    font-style: normal;

    font-size: clamp(3.2rem, 13vw, 9rem);

    line-height: 1;

    letter-spacing: 0.02em;

    white-space: nowrap;
  }

  .odo-letter,
  .odo-strip,
  .odo-strip > span {
    font-family: "Cinzel", serif !important;
    font-weight: 700 !important;
    font-style: normal;
  }

  .odo-year {
    font-family: "Cinzel", serif !important;
    font-weight: 700 !important;
  }

  /* =========================================================
     AXIOS ODOMETER

     The odometer is ONLY a movement system.
     There are no visible cells, panels, backgrounds,
     borders, masks, gradients or shadows on the windows.

     The typography remains continuous.
     ========================================================= */

  .axios-odometer {
    --odo-slot: 1.12em;
    --odo-w: 0.82em; /* was hardcoded as 0.68em */

    display: inline-flex;

    font-family: "Cinzel", serif !important;
    font-weight: 700 !important;
    font-style: normal;

    line-height: 1;

    white-space: nowrap;

    align-items: baseline;

    justify-content: center;

    position: relative;

    height: var(--odo-slot);

    margin: 0;
    padding: 0;

    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    outline: 0 !important;

    overflow: visible;
  }

  /* ---------------------------------------------------------
     Individual character viewport
     --------------------------------------------------------- */

  .odo-letter {
    position: relative;

    display: block;

    width: var(--odo-w);
    height: var(--odo-slot);

    flex: 0 0 var(--odo-w);

    margin: 0;
    padding: 0;

    overflow: hidden;

    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    outline: 0 !important;

    vertical-align: baseline;
  }

  /* ---------------------------------------------------------
     Moving glyph strip
     --------------------------------------------------------- */

  .odo-strip {
    position: absolute;

    top: 0;
    left: 0;

    width: 100%;
    height: calc(var(--odo-slot) * 5);

    display: flex;
    flex-direction: column;

    margin: 0;
    padding: 0;

    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;

    transform: translate3d(0, 0, 0);

    will-change: transform;

    animation: axios-odometer-roll 0.5s cubic-bezier(0.16, 0.75, 0.25, 1)
      forwards;

    animation-delay: calc(0.5s + var(--odo-index) * 0.08s);
  }

  /* ---------------------------------------------------------
     Glyphs
     TEXT ONLY.
     No element-sized background is used.
     --------------------------------------------------------- */

  .odo-strip > span {
    display: flex;

    align-items: center;
    justify-content: center;

    flex: 0 0 var(--odo-slot);

    width: 100%;
    height: var(--odo-slot);

    margin: 0;
    padding: 0 0.04em; /* ← prevents glyph edge clipping */

    box-sizing: border-box;

    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    line-height: 1;
    letter-spacing: inherit;

    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    outline: 0 !important;

    color: #d8b474;
    -webkit-text-fill-color: #d8b474;

    text-shadow: 0 0 22px rgba(212, 168, 108, 0.18);
  }

  /* ---------------------------------------------------------
     Sequential timing
     --------------------------------------------------------- */

  .odo-letter:nth-child(1) {
    --odo-index: 0;
  }

  .odo-letter:nth-child(2) {
    --odo-index: 1;
  }

  .odo-letter:nth-child(3) {
    --odo-index: 2;
  }

  .odo-letter:nth-child(4) {
    --odo-index: 3;
  }

  .odo-letter:nth-child(5) {
    --odo-index: 4;
  }

  /* ---------------------------------------------------------
     Space between AXIOS and '26
     --------------------------------------------------------- */

  .odo-space {
    display: inline-block;

    width: 0.28em;
    height: var(--odo-slot);

    flex: 0 0 0.28em;

    margin: 0;
    padding: 0;

    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
  }

  /* ---------------------------------------------------------
     Year — ordinary typography, NOT an odometer cell
     --------------------------------------------------------- */

  .odo-year {
    display: inline-block;

    position: relative;

    margin: 0;
    padding: 0;

    font-family: inherit;
    font-size: 0.55em;
    font-weight: inherit;
    line-height: 1;

    vertical-align: baseline;

    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    outline: 0 !important;

    color: #d8b474;
    -webkit-text-fill-color: #d8b474;

    text-shadow: 0 0 22px rgba(212, 168, 108, 0.18);
  }

  /* ---------------------------------------------------------
     Odometer roll

     Five slots:

       Α / Ξ / Ι / Ο / Σ  = starting glyph
       Λ / Ζ / Τ / Θ / Ε  = intermediate
       Δ / Σ / Η / Ω / Ξ  = intermediate
       Γ / Χ / Ι / Ο / Σ  = intermediate
       A / X / I / O / S  = final glyph
     --------------------------------------------------------- */

  @keyframes axios-odometer-roll {
    0% {
      transform: translate3d(0, 0, 0);
    }

    12% {
      transform: translate3d(0, calc(var(--odo-slot) * -0.65), 0);
    }

    28% {
      transform: translate3d(0, calc(var(--odo-slot) * -1.65), 0);
    }

    45% {
      transform: translate3d(0, calc(var(--odo-slot) * -2.75), 0);
    }

    60% {
      transform: translate3d(0, calc(var(--odo-slot) * -3.55), 0);
    }

    72% {
      transform: translate3d(0, calc(var(--odo-slot) * -4.05), 0);
    }

    82% {
      transform: translate3d(0, calc(var(--odo-slot) * -4.35), 0);
    }

    90% {
      transform: translate3d(0, calc(var(--odo-slot) * -4.05), 0);
    }

    100% {
      transform: translate3d(0, calc(var(--odo-slot) * -4), 0);
    }
  }

  /* =========================================================
     SECONDARY TITLE
     ========================================================= */

  .line2 {
    margin-top: 0.5rem;

    font-family: var(--font-serif);

    font-style: italic;

    font-weight: 500;

    font-size: clamp(0.85rem, 2vw, 1.15rem);

    color: var(--ink-faint);

    letter-spacing: 0.16em;

    text-transform: uppercase;
  }

  /* =========================================================
     GREEK LINE
     ========================================================= */

  .line-greek {
    display: flex;

    align-items: baseline;

    justify-content: center;

    gap: 0.5em;

    font-family: var(--font-display);

    font-size: 0.68rem;

    letter-spacing: 0.32em;

    color: var(--gold-dim);
  }

  /* =========================================================
     SCREEN READER
     ========================================================= */

  .sr-only {
    position: absolute;

    width: 1px;
    height: 1px;

    padding: 0;
    margin: -1px;

    overflow: hidden;

    clip: rect(0, 0, 0, 0);

    white-space: nowrap;

    border: 0;
  }

  /* =========================================================
     ΑΞΙΟΣ → WORTHY
     ========================================================= */

  .axios-morph {
    position: relative;

    display: inline-grid;
  }

  .morph-greek,
  .morph-english {
    grid-area: 1 / 1;

    white-space: nowrap;
  }

  .morph-greek {
    animation: morph-out 0.9s ease-in-out 2.6s forwards;
  }

  .morph-english {
    opacity: 0;

    color: var(--gold-bright);

    animation: morph-in 0.9s ease-in-out 2.6s forwards;
  }

  @keyframes morph-out {
    0% {
      opacity: 1;

      filter: blur(0);

      transform: scale(1);
    }

    45% {
      opacity: 0;

      filter: blur(8px);

      transform: scale(1.2);
    }

    100% {
      opacity: 0;

      filter: blur(8px);

      transform: scale(1.2);
    }
  }

  @keyframes morph-in {
    0% {
      opacity: 0;

      filter: blur(8px);

      transform: scale(0.8);
    }

    55% {
      opacity: 0;

      filter: blur(8px);

      transform: scale(0.8);
    }

    100% {
      opacity: 1;

      filter: blur(0);

      transform: scale(1);

      text-shadow: 0 0 14px rgba(238, 200, 122, 0.55);
    }
  }

  /* =========================================================
     MEANDER
     ========================================================= */

  .meander {
    width: 96px;

    height: 14px;

    margin: 0.6rem auto 0;

    color: var(--gold-dim);

    opacity: 0.7;
  }

  .meander svg {
    width: 100%;
    height: 100%;

    display: block;
  }

  /* =========================================================
     ACTIONS
     ========================================================= */

  .hero-actions {
    display: flex;

    gap: 1rem;

    flex-wrap: wrap;

    justify-content: center;

    margin-top: 0.5rem;

    width: 100%;
  }

  /* =========================================================
     COUNTDOWN
     ========================================================= */

  .countdown {
    margin-top: 1.5rem;

