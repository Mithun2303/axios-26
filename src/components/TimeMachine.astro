---
import Icon from './Icon.astro';
import { events, type AxiosEvent } from '../data/events';

interface ScheduleEntry {
	key: string;
	eventKey: string;
	name: string;
	icon: string;
	category: AxiosEvent['category'];
	round: string;
	roundTitle: string;
	day: string;
	startLabel: string;
	endLabel: string;
	startMinutes: number;
	endMinutes: number;
	location: string;
}

const parseTime = (hhmm: string) => {
	const [h, m] = hhmm.split(':').map(Number);
	return h * 60 + m;
};

const schedule: ScheduleEntry[] = events.flatMap((ev) =>
	ev.timeline.map((row, i) => {
		const [startLabel, endLabel] = row.time.split(/[–—-]/).map((s) => s.trim());
		const roundIndex = parseInt(row.r.replace(/\D/g, ''), 10) - 1;
		return {
			key: `${ev.key}-${row.r}`,
			eventKey: ev.key,
			name: ev.name,
			icon: ev.icon,
			category: ev.category,
			round: row.r,
			roundTitle: ev.rounds[roundIndex]?.t ?? row.r,
			day: row.day,
			startLabel,
			endLabel,
			startMinutes: parseTime(startLabel),
			endMinutes: parseTime(endLabel),
			location: row.loc,
		};
	})
);

const days = Array.from(new Set(schedule.map((s) => s.day))).sort();
const categories: AxiosEvent['category'][] = ['Technical', 'Non Technical', 'Gaming'];

const DAY_START = 8 * 60;
const DAY_END = 18 * 60;
const DAY_RANGE = DAY_END - DAY_START;
const DAY_COL_WIDTH = 1450;
const MIN_BLOCK_WIDTH = 108;
const ROW_H = 64; // px, one sub-row's height inside a lane
const ROW_GAP = 8; // px, gap between stacked sub-rows in the same lane
const hours = Array.from({ length: (DAY_END - DAY_START) / 60 + 1 }, (_, i) => DAY_START / 60 + i);
const fmtHour = (h: number) => `${String(h % 24).padStart(2, '0')}:00`;

const entriesFor = (day: string, cat: string) => schedule.filter((s) => s.day === day && s.category === cat);
const catSlug = (cat: string) => cat.toLowerCase().replace(/\s+/g, '-');

// --- overlap packing: greedy interval-graph sweep, on TRUE end times (not the
// min-width-inflated on-screen width) so a short block never falsely collides with its
// neighbour just because MIN_BLOCK_WIDTH padded it out visually. Each entry gets the
// lowest sub-row index whose last-placed end time is already <= this entry's start —
// the standard "minimum number of rooms" packing — so overlapping events stack into
// separate rows instead of covering each other, and non-overlapping ones share a row.
type Packed = ScheduleEntry & { subRow: number };

const packLane = (entries: ScheduleEntry[]): { items: Packed[]; subRowCount: number } => {
	const sorted = [...entries].sort((a, b) => a.startMinutes - b.startMinutes);
	const rowEnds: number[] = []; // rowEnds[i] = end time of the last event placed in sub-row i
	const items: Packed[] = sorted.map((entry) => {
		let row = rowEnds.findIndex((end) => end <= entry.startMinutes);
		if (row === -1) {
			row = rowEnds.length;
			rowEnds.push(entry.endMinutes);
		} else {
			rowEnds[row] = entry.endMinutes;
		}
		return { ...entry, subRow: row };
	});
	return { items, subRowCount: Math.max(1, rowEnds.length) };
};

interface Props {
	// renders a second, inert copy of just the schedule grid — no ids (so the script below,
	// which is hoisted once per page by Astro regardless of how many times this component is
	// rendered, only ever wires up the real instance), no modal, no scroll/pin behaviour. Used
	// by EventsCinema's tunnel to show a static preview of this section without it fighting
	// the real one for the same DOM ids or corrupting its day/readout math.
	preview?: boolean;
}

const { preview = false } = Astro.props;
---

<section class:list={['tm', preview && 'tm-preview']} id={preview ? undefined : 'schedule'} aria-hidden={preview ? 'true' : undefined}>
	{!preview && (
		<div class="tm-intro container" data-reveal="fade">
			<p class="eyebrow">The Schedule</p>
			<h2 class="section-title">The <em>Time</em> Machine</h2>
			<p class="lede">Scroll to move through time — two days, ten arenas, mapped minute by minute.</p>
		</div>
	)}

	<div class="tm-pin" id={preview ? undefined : 'tm-pin'}>
		<div class:list={['tm-stage', !preview && 'tm-stage-entering']} id={preview ? undefined : 'tm-stage'}>
			<div class="tm-header container">
				<span class="tm-header-label">Scroll to move through time</span>
				<span class="tm-readout" id={preview ? undefined : 'tm-readout'}>{days[0]} &middot; {fmtHour(DAY_START / 60)}</span>
			</div>

			<div class="tm-hand" id={preview ? undefined : 'tm-hand'} aria-hidden="true"></div>

			<div class="tm-viewport">
				<div class="tm-track" id={preview ? undefined : 'tm-track'}>
					{days.map((day) => (
						<div class="tm-day" style={`width:${DAY_COL_WIDTH}px`}>
							<div class="tm-day-label">{day}</div>
							<div class="tm-axis" aria-hidden="true">
								{hours.map((h) => (
									<span style={`left:${((h * 60 - DAY_START) / DAY_RANGE) * DAY_COL_WIDTH}px`}>{fmtHour(h)}</span>
								))}
							</div>
							{/* thin loader track, one per day, directly under the axis — its fill width is
							    driven each frame by the script below from the same progress value that
							    moves the hand, so it reads as "time already scrolled past" for this day. */}
							<div class="tm-day-loader" aria-hidden="true">
								<div class="tm-day-loader-fill" data-day={day}></div>
							</div>
							<div class="tm-lanes">
								{categories.map((cat) => {
									const { items, subRowCount } = packLane(entriesFor(day, cat));
									const trackHeight = subRowCount * ROW_H + (subRowCount - 1) * ROW_GAP;
									return (
										<div class="tm-lane" data-cat={catSlug(cat)}>
											<span class="tm-lane-label">{cat}</span>
											<div
												class="tm-lane-track"
												style={`height:${trackHeight}px; background-size: ${(60 / DAY_RANGE) * DAY_COL_WIDTH}px 100%;`}
											>
												{items.map((entry) => {
													const left = ((entry.startMinutes - DAY_START) / DAY_RANGE) * DAY_COL_WIDTH;
													const width = Math.max(
														((entry.endMinutes - entry.startMinutes) / DAY_RANGE) * DAY_COL_WIDTH,
														MIN_BLOCK_WIDTH
													);
													const top = entry.subRow * (ROW_H + ROW_GAP);
													// multi-row lanes give each block less vertical room — drop the meta
													// line there rather than let it clip; the modal already repeats
													// time + location in full.
													const compact = subRowCount > 1;
													return (
														<button
															type="button"
															class:list={['tm-block', compact && 'tm-block-compact']}
															data-cat={catSlug(cat)}
															style={`left:${left}px; width:${width}px; top:${top}px; height:${ROW_H}px;`}
															data-key={entry.key}
															data-event={entry.eventKey}
															data-icon={entry.icon}
															data-name={entry.name}
															data-category={entry.category}
															data-round={entry.round}
															data-round-title={entry.roundTitle}
															data-day={entry.day}
															data-time={`${entry.startLabel}–${entry.endLabel}`}
															data-loc={entry.location}
														>
															{/* --- glass banner: --before paints the "banner" (a per-category
															    gradient placeholder today; swap for a real image later by
															    giving this element a background-image instead — nothing
															    else in this stack needs to change), the frosted layer above
															    it blurs that backdrop, and content sits on top so text never
															    blurs with it. --- */}
															<span class="tm-block-banner" aria-hidden="true"></span>
															<span class="tm-block-glass" aria-hidden="true"></span>
															<span class="tm-block-content">
																<span class="tm-block-name">{entry.name}</span>
																{!compact && (
																	<span class="tm-block-meta">{entry.startLabel}&ndash;{entry.endLabel} &middot; {entry.location}</span>
																)}
															</span>
														</button>
													);
												})}
											</div>
										</div>
									);
								})}
							</div>
						</div>
					))}
				</div>
			</div>
		</div>
	</div>

	<!-- mobile / reduced-motion fallback: plain vertical accordion, no scroll-jacking.
	     Skipped for the preview instance — the tunnel that embeds it is desktop-only already. -->
	{!preview && (
		<div class="tm-mobile container">
			{days.map((day, i) => (
				<details class="tm-day-acc" open={i === 0}>
					<summary>
						<span>{day}</span>
						<Icon name="chevron-down" class="tm-acc-chevron" />
					</summary>
					<ul class="tm-list">
						{schedule
							.filter((s) => s.day === day)
							.sort((a, b) => a.startMinutes - b.startMinutes)
							.map((entry) => (
								<li>
									<button
										type="button"
										class="tm-row"
										data-cat={catSlug(entry.category)}
										data-key={entry.key}
										data-event={entry.eventKey}
										data-icon={entry.icon}
										data-name={entry.name}
										data-category={entry.category}
										data-round={entry.round}
										data-round-title={entry.roundTitle}
										data-day={entry.day}
										data-time={`${entry.startLabel}–${entry.endLabel}`}
										data-loc={entry.location}
									>
										<span class="tm-row-time">{entry.startLabel}&ndash;{entry.endLabel}</span>
										<span class="tm-row-body">
											<span class="tm-row-name">{entry.name}</span>
											<span class="tm-row-meta">{entry.roundTitle} &middot; {entry.location}</span>
										</span>
									</button>
								</li>
							))}
					</ul>
				</details>
			))}
		</div>
	)}
</section>

{!preview && (
	<Fragment>
		<div class="tm-icon-registry" hidden aria-hidden="true">
			{Array.from(new Set(events.map((e) => e.icon))).map((iconName) => (
				<span data-icon-src={iconName}><Icon name={iconName} /></span>
			))}
		</div>

		<div class="tm-modal" id="tm-modal" aria-hidden="true">
			<div class="tm-modal-backdrop" id="tm-modal-backdrop"></div>
			<div class="tm-modal-panel" role="dialog" aria-modal="true" aria-labelledby="tm-modal-name">
				<button type="button" class="tm-modal-close" id="tm-modal-close" aria-label="Close">&times;</button>
				<div class="tm-modal-icon" id="tm-modal-icon"></div>
				<p class="tm-modal-tag" id="tm-modal-tag"></p>
				<h3 id="tm-modal-name"></h3>
				<p class="tm-modal-round" id="tm-modal-round"></p>
				<dl class="tm-modal-meta">
					<div><dt>When</dt><dd id="tm-modal-when"></dd></div>
					<div><dt>Where</dt><dd id="tm-modal-loc"></dd></div>
				</dl>
				<a class="btn ghost" id="tm-modal-link" href="#lineup">See full details</a>
			</div>
		</div>
	</Fragment>
)}

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	// scoped to the real instance only: the query excludes .tm-preview, so a second,
	// inert render of this component elsewhere on the page (see the `preview` prop)
	// never gets counted into the day/readout math or wired up for clicks.
	const root = document.querySelector<HTMLElement>('.tm:not(.tm-preview)');

	const pin = document.getElementById('tm-pin');
	const stage = document.getElementById('tm-stage');
	const track = document.getElementById('tm-track');
	const hand = document.getElementById('tm-hand');
	const readout = document.getElementById('tm-readout');

	// kill the CSS pre-state (see .tm-stage-entering below) as the very first thing this
	// script does — if anything below throws, the section still ends up at full scale
	// instead of stuck at 0.32 forever.
	stage?.classList.remove('tm-stage-entering');

	const DAY_START = 8 * 60;
	const DAY_RANGE = 600;
	const DAY_COL_WIDTH = 1450; // must match the frontmatter's DAY_COL_WIDTH
	const dayLabels = Array.from(root?.querySelectorAll<HTMLElement>('.tm-day-label') ?? []).map((el) => el.textContent || '');
	const numDays = Math.max(1, dayLabels.length);
	// one thin loader-fill per day (queried by index, in day order — same order
	// .tm-day-label above and the frontmatter's days.map both render in)
	const loaderFills = Array.from(root?.querySelectorAll<HTMLElement>('.tm-day-loader-fill') ?? []);
	const loaderByDay: HTMLElement[] = dayLabels.map((_, i) =>
		loaderFills.find((el) => el.dataset.day === dayLabels[i])
	).filter((el): el is HTMLElement => !!el);

	const fmt = (mins: number) => {
		const h = Math.floor(mins / 60) % 24;
		const m = Math.floor(mins % 60);
		return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
	};

	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	// entrance: the stage starts scaled down — as if it's still the last thing sitting
	// inside the grid above — and grows to full size as you scroll into it. Scaled on
	// .tm-stage itself (the sticky element), NOT on `root` or any other ancestor of it:
	// ScrollTrigger's pin sets the pinned element to position:fixed, and a transform on
	// an ancestor of a sticky element independently breaks its sticky behaviour. Either
	// one, with .tm-stage sticky underneath, was the source of the snap/misalignment at
	// the handoff into the horizontal scrub below. No pin needed here at all — native
	// sticky already holds .tm-stage in place while its own transform animates.
	const isDesktop = window.matchMedia('(min-width: 901px)').matches;
	if (root && stage && !prefersReducedMotion && isDesktop) {
		ScrollTrigger.create({
			trigger: root,
			start: 'top bottom',
			end: 'top top',
			scrub: 1,
			onUpdate: (self) => gsap.set(stage, { scale: gsap.utils.interpolate(0.32, 1, self.progress) }),
		});
	} else if (stage) {
		gsap.set(stage, { clearProps: 'transform' });
	}

	let scrollDistance = 0;
	// .tm-track has responsive left padding (clamp(1.25rem, 4vw, 3rem)) that the axis,
	// loader and blocks all sit inside — measured live rather than duplicated as a magic
	// number here, so it can't silently drift out of sync with the CSS again. Read once:
	// it only changes on resize, and measure() below is already called on resize.
	let trackPaddingLeft = 0;
	// px offset from the left edge of .tm-track's content box to the left edge of day
	// i's column — each .tm-day is DAY_COL_WIDTH wide, so day i starts at i * DAY_COL_WIDTH,
	// plus the track's own left padding.
	const dayOffsetPx = (i: number) => trackPaddingLeft + i * DAY_COL_WIDTH;

	const measure = () => {
		if (!pin || !track) return;
		const vh = window.innerHeight;
		const vw = window.innerWidth;
		scrollDistance = Math.max(0, track.scrollWidth - vw);
		pin.style.height = `${vh + scrollDistance}px`;
		trackPaddingLeft = parseFloat(getComputedStyle(track).paddingLeft) || 0;
	};

	const update = () => {
		if (!pin || !track) return;
		const rect = pin.getBoundingClientRect();
		const vh = window.innerHeight;
		const total = rect.height - vh;
		let progress = total > 0 ? -rect.top / total : 0;
		progress = Math.min(1, Math.max(0, progress));

		const trackOffsetPx = progress * scrollDistance;
		track.style.transform = `translateX(${-trackOffsetPx}px)`;

		const totalMinutesScrubbed = progress * DAY_RANGE * numDays;
		const dayIndex = Math.min(numDays - 1, Math.floor(totalMinutesScrubbed / DAY_RANGE));
		const minuteOfDay = DAY_START + (totalMinutesScrubbed - dayIndex * DAY_RANGE);

		if (readout) {
			readout.textContent = `${dayLabels[dayIndex] || `Day ${dayIndex + 1}`} · ${fmt(minuteOfDay)}`;
		}

		// "now", in the same track-local px the axis/blocks/loader all use: the current
		// day's column offset plus how far into that day's DAY_COL_WIDTH we've scrubbed.
		const nowPx = dayOffsetPx(dayIndex) + (minuteOfDay - DAY_START) * (DAY_COL_WIDTH / DAY_RANGE);

		// the hand is drawn in viewport space, so convert track-local "now" to a viewport
		// x by subtracting the track's current scroll offset — this is what keeps it
		// exactly over the loader's leading edge and the axis mark for "now" instead of
		// sweeping independently across the full viewport width.
		if (hand) {
			hand.style.transform = `translateX(${nowPx - trackOffsetPx}px)`;
		}

		// loader fill: each day's bar is clamped to its own [0,1] segment of the global
		// progress — full once the hand has moved past that whole day, still empty for a
		// day the hand hasn't reached yet. Uses the same nowPx math as the hand above, so
		// the fill's right edge and the hand line always land on the same px.
		for (let i = 0; i < numDays; i++) {
			const dayProgress = Math.min(1, Math.max(0, totalMinutesScrubbed / DAY_RANGE - i));
			const el = loaderByDay[i];
			if (el) el.style.width = `${dayProgress * DAY_COL_WIDTH}px`;
		}
	};

	if (!prefersReducedMotion) {
		measure();
		update();
		// driven by GSAP's own ticker rather than a scroll listener firing its own rAF:
		// one read-and-write per animation frame, in the same frame GSAP is already
		// ticking, instead of a queue of scroll-event callbacks that can pile up and
		// race against the entrance scale tween above.
		gsap.ticker.add(update);
		window.addEventListener('resize', () => {
			measure();
			update();
		});
	}

	// --- detail modal, shared by desktop blocks and mobile rows ---
	const modal = document.getElementById('tm-modal');
	// reparent to <body> so its position:fixed anchors to the real viewport regardless
	// of where in the DOM this component ends up.
	if (modal && modal.parentElement !== document.body) document.body.appendChild(modal);
	const modalIcon = document.getElementById('tm-modal-icon');
	const modalTag = document.getElementById('tm-modal-tag');
	const modalName = document.getElementById('tm-modal-name');
	const modalRound = document.getElementById('tm-modal-round');
	const modalWhen = document.getElementById('tm-modal-when');
	const modalLoc = document.getElementById('tm-modal-loc');

	let lastFocused: HTMLElement | null = null;

	const openModal = (btn: HTMLElement) => {
		const d = btn.dataset;
		if (modalIcon) {
			const src = d.icon ? document.querySelector(`[data-icon-src="${d.icon}"]`) : null;
			modalIcon.innerHTML = src ? src.innerHTML : '';
		}
		if (modalTag) modalTag.textContent = d.category || '';
		if (modalName) modalName.textContent = d.name || '';
		if (modalRound) modalRound.textContent = d.roundTitle || '';
		if (modalWhen) modalWhen.textContent = `${d.day} · ${d.time}`;
		if (modalLoc) modalLoc.textContent = d.loc || '';
		lastFocused = document.activeElement as HTMLElement;
		modal?.classList.add('is-open');
		modal?.setAttribute('aria-hidden', 'false');
		document.body.style.overflow = 'hidden';
		(document.getElementById('tm-modal-close') as HTMLElement | null)?.focus();
	};

	const closeModal = () => {
		modal?.classList.remove('is-open');
		modal?.setAttribute('aria-hidden', 'true');
		document.body.style.overflow = '';
		lastFocused?.focus();
	};

	root?.querySelectorAll<HTMLElement>('.tm-block, .tm-row').forEach((btn) => {
		btn.addEventListener('click', () => openModal(btn));
	});

	document.getElementById('tm-modal-close')?.addEventListener('click', closeModal);
	document.getElementById('tm-modal-backdrop')?.addEventListener('click', closeModal);
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && modal?.classList.contains('is-open')) closeModal();
	});
</script>

<style>
	.tm {
		position: relative;
		background: linear-gradient(180deg, var(--deep-2), var(--void) 15%, var(--void) 85%, var(--deep-2));
		padding-top: 6rem;
	}

	.tm-intro {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.1rem;
		margin-bottom: 3rem;
	}

	/* --- pinned desktop scrub --- */
	.tm-pin {
		position: relative;
		height: 400vh;
	}

	.tm-stage {
		position: sticky;
		top: 0;
		height: 100vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		overflow: hidden;
		transform-origin: 50% 50%;
	}

	/* pre-state for the entrance scale, present before the deferred script runs so the
	   stage never flashes full-size then snaps to 0.32. The script removes this class as
	   its first statement (see the top of the <script> below), so a later error in that
	   script can't leave the section stuck scaled down. Scoped to match exactly the
	   conditions the script itself checks before animating. */
	@media (min-width: 901px) and (prefers-reduced-motion: no-preference) {
		.tm:not(.tm-preview) .tm-stage-entering {
			transform: scale(0.32);
		}
	}

	/* the preview instance never runs the pin/scrub script above (it has no ids for that
	   script to find), so it doesn't need — and shouldn't keep — the tall scroll runway or
	   the sticky pin: both are meaningless without the JS driving them, and left in place
	   they'd just make an oversized, inert copy sit behind whatever embeds it. */
	.tm-preview .tm-pin {
		height: auto;
	}

	.tm-preview .tm-stage {
		position: static;
		height: auto;
	}

	.tm-preview {
		pointer-events: none;
	}

	.tm-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		width: 100%;
		margin-bottom: 1.4rem;
		font-family: var(--font-display);
	}

	.tm-header-label {
		font-size: 0.7rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.tm-readout {
		font-size: 0.95rem;
		letter-spacing: 0.12em;
		color: var(--gold-bright);
		font-variant-numeric: tabular-nums;
	}

	.tm-hand {
		position: absolute;
		top: 5.5rem;
		bottom: 3rem;
		width: 2px;
		background: linear-gradient(180deg, transparent, var(--gold-bright) 12%, var(--gold-bright) 88%, transparent);
		box-shadow: 0 0 14px rgba(238, 200, 122, 0.65), 0 0 28px rgba(238, 200, 122, 0.3);
		will-change: transform;
		pointer-events: none;
		z-index: 4;
	}

	.tm-hand::before {
		content: '';
		position: absolute;
		top: -5px;
		left: 50%;
		width: 8px;
		height: 8px;
		transform: translateX(-50%) rotate(45deg);
		background: var(--gold-bright);
		box-shadow: 0 0 10px rgba(238, 200, 122, 0.7);
	}

	.tm-viewport {
		overflow: hidden;
	}

	.tm-track {
		display: flex;
		will-change: transform;
		padding-left: clamp(1.25rem, 4vw, 3rem);
	}

	.tm-day {
		flex: 0 0 auto;
		padding-right: clamp(2.5rem, 6vw, 5rem);
	}

	.tm-day-label {
		font-family: var(--font-display-deco);
		font-size: 1.6rem;
		font-weight: 700;
		color: var(--ink);
		margin-bottom: 0.9rem;
	}

	/* relative + absolutely-placed labels (left set inline per hour, matching the same
