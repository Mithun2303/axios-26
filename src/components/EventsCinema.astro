---
import Icon from './Icon.astro';
import { events, type AxiosEvent } from '../data/events';

interface World {
	key: string;
	label: string;
	match: AxiosEvent['category'];
	accent: string;
	index: string;
	icon: string;
}

const WORLDS: World[] = [
	{ key: 'technical', label: 'Technical', match: 'Technical', accent: 'var(--gold)', index: 'I', icon: 'gear' },
	{ key: 'nontechnical', label: 'Non-Technical', match: 'Non Technical', accent: 'var(--future-2)', index: 'II', icon: 'scroll' },
	{ key: 'gaming', label: 'Gaming', match: 'Gaming', accent: 'var(--ember)', index: 'III', icon: 'joystick' },
];

// Depth layout of the tunnel (px along the z-axis, negative = away from the viewer).
// Each world owns two planes: its name sign, then its event chamber one step deeper.
// The back wall sits just behind the last chamber so the tunnel visibly ends.
const STEP = 450;
const END_DEPTH = STEP * WORLDS.length * 2 + 300;
---

<section class="cinema" id="arenas">
	<div class="cinema-intro container" data-reveal="fade">
		<p class="eyebrow">The Directory</p>
		<h2 class="section-title">Enter the <em class="skew-heading">Arenas</em></h2>
		<p class="lede">Scroll to travel through three classes of events — each one arrives as a name, then opens into its own chamber.</p>
	</div>

	<div class="cinema-stage" id="cinema-stage">
		<div class="cinema-tunnel">
			<!-- four static perspective walls; only their grid texture slides with scroll -->
			<div class="tunnel-wall tunnel-wall--top" aria-hidden="true"><div class="tunnel-grid" data-axis="y" data-dir="-1"></div></div>
			<div class="tunnel-wall tunnel-wall--bottom" aria-hidden="true"><div class="tunnel-grid" data-axis="y" data-dir="1"></div></div>
			<div class="tunnel-wall tunnel-wall--left" aria-hidden="true"><div class="tunnel-grid" data-axis="x" data-dir="-1"></div></div>
			<div class="tunnel-wall tunnel-wall--right" aria-hidden="true"><div class="tunnel-grid" data-axis="x" data-dir="1"></div></div>

			<!-- the far end of the tunnel -->
			<div class="tunnel-plane tunnel-end" data-plane="end" data-offset={-END_DEPTH} aria-hidden="true">
				<svg class="cinema-meander" viewBox="0 0 640 16" preserveAspectRatio="xMidYMid slice">
					<pattern id="cinema-meander-pattern" width="16" height="16" patternUnits="userSpaceOnUse">
						<path d="M0 12h4V4h4v8h4V4h4" fill="none" stroke="currentColor" stroke-width="1.2" />
					</pattern>
					<rect width="640" height="16" fill="url(#cinema-meander-pattern)" />
				</svg>
			</div>

			{WORLDS.map((world, i) => {
				const worldEvents = events.filter((ev) => ev.category === world.match);
				return (
					<div class="cinema-world" data-world={world.key}>
						<div class="tunnel-plane" data-plane="word" data-offset={-(STEP * (2 * i + 1))}>
							<div class="cinema-sign" data-word={world.key}>
								<h3 class="cinema-word" style={`--accent:${world.accent}`}>{world.label}</h3>
								<p class="cinema-word-tag">{worldEvents.map((ev) => ev.tag).join(' · ')}</p>
							</div>
						</div>

						<div class="tunnel-plane" data-plane="frame" data-offset={-(STEP * (2 * i + 2))}>
							<div class="cinema-frame">
								<div class="frame-panel" style={`--accent:${world.accent}`}>
									<span class="fp-corner tr" aria-hidden="true"></span>
									<span class="fp-corner bl" aria-hidden="true"></span>

									<div class="frame-head">
										<span class="frame-index">{world.index}</span>
										<h4>{world.label} Events</h4>
									</div>

									<div class="frame-grid">
										{worldEvents.map((ev, idx) => (
											<a href={`#event-${ev.key}`} class="frame-item">
												<span class="frame-item-num">{String(idx + 1).padStart(2, '0')}</span>
												<span class="frame-item-icon"><Icon name={ev.icon} /></span>
												<span class="frame-item-body">
													<strong>{ev.name}</strong>
													<span class="frame-item-desc">{ev.tag}</span>
												</span>
												<Icon name="arrow-right" class="frame-item-arrow" />
											</a>
										))}
									</div>

									<div class="frame-foot">
										<a href="#lineup" class="btn ghost frame-cta">Explore Events <Icon name="arrow-right" /></a>
									</div>
								</div>
							</div>
						</div>
					</div>
				);
			})}
		</div>

		<!-- fades the whole scene to the void at the end, without touching the 3D context -->
		<div class="cinema-veil" aria-hidden="true"></div>
	</div>
</section>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	type PlaneKind = 'word' | 'frame' | 'end';

	interface Layer {
		el: HTMLElement;
		kind: PlaneKind;
		offset: number;
		items: HTMLElement[];
	}

	const stage = document.getElementById('cinema-stage');
	const tunnel = stage?.querySelector<HTMLElement>('.cinema-tunnel') ?? null;
	const veil = stage?.querySelector<HTMLElement>('.cinema-veil') ?? null;
	const worlds = Array.from(document.querySelectorAll<HTMLElement>('.cinema-world'));

	if (stage && tunnel && veil && worlds.length > 0) {
		const mm = gsap.matchMedia();

		mm.add(
			{
				isDesktop: '(min-width: 901px)',
				reduceMotion: '(prefers-reduced-motion: reduce)',
			},
			(context) => {
				const { isDesktop, reduceMotion } = context.conditions as { isDesktop: boolean; reduceMotion: boolean };

				// reduced motion: CSS lays everything out statically, nothing animates
				if (reduceMotion) return;

				if (!isDesktop) {
					// lightweight in-flow reveal per world, no pin, no 3D
					worlds.forEach((world) => {
						const word = world.querySelector<HTMLElement>('.cinema-word');
						const frame = world.querySelector<HTMLElement>('.cinema-frame');
						const items = world.querySelectorAll<HTMLElement>('.frame-item');
						if (!word || !frame) return;

						gsap.timeline({
							scrollTrigger: {
								trigger: world,
								start: 'top 78%',
								toggleActions: 'play none none reverse',
							},
						})
							.from(word, { autoAlpha: 0, y: 32, duration: 0.6, ease: 'power2.out' })
							.from(frame, { autoAlpha: 0, y: 32, duration: 0.6, ease: 'power2.out' }, '-=0.25')
							.from(items, { autoAlpha: 0, y: 18, duration: 0.4, stagger: 0.06, ease: 'power2.out' }, '-=0.3');
					});
					return;
				}

				// ---------------------------------------------------------------------------
				// Desktop: fly through the tunnel.
				//
				// One scalar, `travel` (px), is scrubbed by scroll. Every plane sits at
				// z = offset + travel, so the whole stack slides toward the viewer while the
				// four walls stay put and only their grid texture slides — nothing ever has
				// to cross the camera plane, which is what made the old version glitch.
				// Opacity is a pure function of z, so scrubbing backwards is always exact.
				// ---------------------------------------------------------------------------
				const TAIL = 320; // travel-units for the final fade to void
				const SCROLL_PX_PER_UNIT = 1.9;

				const gridSize = parseFloat(getComputedStyle(tunnel).getPropertyValue('--tunnel-grid')) || 160;
				const grids = Array.from(tunnel.querySelectorAll<HTMLElement>('.tunnel-grid'));

				const layers: Layer[] = Array.from(tunnel.querySelectorAll<HTMLElement>('.tunnel-plane')).map((el) => {
					const kind = (el.dataset.plane ?? 'word') as PlaneKind;
					return {
						el,
						kind,
						offset: parseFloat(el.dataset.offset ?? '0'),
						items: kind === 'frame' ? Array.from(el.querySelectorAll<HTMLElement>('.frame-item')) : [],
					};
				});
				const chambers = layers.filter((l) => l.kind === 'frame');
				const farthest = Math.min(...layers.map((l) => l.offset));

				const clamp01 = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
				const ramp = (z: number, from: number, to: number) => clamp01((z - from) / (to - from));

				// distant things are dimmer, everything fades as it passes the viewer
				const alphaAt = (kind: PlaneKind, z: number) => {
					if (kind === 'end') return 1;
					const fog = 0.3 + 0.7 * ramp(z, farthest, -700);
					if (kind === 'word') return fog * ramp(z, farthest, farthest + 500) * (1 - ramp(z, 40, 420));
					return fog * ramp(z, -850, -420) * (1 - ramp(z, 40, 260));
				};

				const state = { travel: 0 };

				const render = () => {
					const travel = state.travel;

					for (const layer of layers) {
						const z = layer.offset + travel;
						const alpha = alphaAt(layer.kind, z);
						const style = layer.el.style;
						style.transform = `translate3d(0,0,${z}px)`;
						style.opacity = String(alpha);
						style.visibility = alpha > 0.002 ? 'visible' : 'hidden';

						// event rows step in one after another as the chamber approaches
						layer.items.forEach((item, i) => {
							const p = ramp(z, -720 + i * 32, -430 + i * 32);
							item.style.opacity = String(p);
							item.style.transform = `translate3d(0,${(1 - p) * 22}px,0)`;
						});
					}

					const shift = travel % gridSize;
					for (const grid of grids) {
						const d = shift * Number(grid.dataset.dir ?? 1);
						grid.style.transform = grid.dataset.axis === 'x' ? `translate3d(${d}px,0,0)` : `translate3d(0,${d}px,0)`;
					}
				};

				// timeline time == travel px: one continuous, linear glide the whole length of
				// the tunnel — no pauses in front of any chamber. Each chamber still reads
				// clearly because alphaAt() keeps it at full opacity for a wide band of travel,
				// not because scroll itself stalls there.
				const farthestChamberOffset = Math.min(...chambers.map((c) => c.offset));
				const finalTravel = -farthestChamberOffset + TAIL;

				const tl = gsap.timeline({ onUpdate: render });
				tl.to(state, { travel: finalTravel, duration: finalTravel, ease: 'none' }, 0);
				tl.to(veil, { opacity: 1, duration: TAIL, ease: 'none' }, finalTravel - TAIL);

				render();

				ScrollTrigger.create({
					animation: tl,
					trigger: stage,
					start: 'top top',
					end: () => '+=' + Math.round(tl.duration() * SCROLL_PX_PER_UNIT),
					scrub: 1,
					pin: true,
					anticipatePin: 1,
				});

				// leaving desktop: drop every inline style render() wrote
				return () => {
					for (const layer of layers) {
						layer.el.removeAttribute('style');
						layer.items.forEach((item) => item.removeAttribute('style'));
					}
					grids.forEach((g) => g.removeAttribute('style'));
					veil.removeAttribute('style');
				};
			}
		);
	}
</script>

<style>
	.cinema {
		position: relative;
		background: var(--void);
	}

	.cinema-intro {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.1rem;
		padding: 7rem 0 3rem;
	}

	/* --- pinned stage (GSAP ScrollTrigger creates the spacer) --- */
	.cinema-stage {
		position: relative;
		height: 100vh;
		overflow: hidden;
		background: var(--void);
		--tunnel-persp: 1000px;
		--tunnel-depth: 3200px;
		--tunnel-grid: 160px;
		--tunnel-line: color-mix(in srgb, var(--gold) 26%, transparent);
	}

	/* the single 3D context: perspective here, preserve-3d so walls, end and planes
	   depth-sort against each other instead of painting in DOM order */
	.cinema-tunnel {
		position: absolute;
		inset: 0;
		perspective: var(--tunnel-persp);
		perspective-origin: 50% 50%;
		transform-style: preserve-3d;
	}

	.cinema-veil {
		position: absolute;
		inset: 0;
		background: var(--void);
		opacity: 0;
		pointer-events: none;
	}

	/* --- walls: four viewport-edge planes folded 90° into the depth axis --- */
	.tunnel-wall {
		position: absolute;
		overflow: hidden;
		background: rgba(255, 255, 255, 0.012);
	}

	.tunnel-wall--top,
	.tunnel-wall--bottom {
		left: 0;
		width: 100%;
		height: var(--tunnel-depth);
	}

	.tunnel-wall--left,
	.tunnel-wall--right {
		top: 0;
		height: 100%;
		width: var(--tunnel-depth);
	}

	.tunnel-wall--top {
		top: 0;
		transform-origin: 50% 0;
		transform: rotateX(-90deg);
	}

	.tunnel-wall--bottom {
		bottom: 0;
		transform-origin: 50% 100%;
		transform: rotateX(90deg);
	}

	.tunnel-wall--left {
		left: 0;
		transform-origin: 0 50%;
		transform: rotateY(90deg);
	}

	.tunnel-wall--right {
		right: 0;
		transform-origin: 100% 50%;
		transform: rotateY(-90deg);
	}

	/* grid texture, oversized by one cell each side so it can slide by up to a cell */
	.tunnel-grid {
		position: absolute;
		inset: calc(var(--tunnel-grid) * -1);
		background-image:
			repeating-linear-gradient(to bottom, var(--tunnel-line) 0 1px, transparent 1px var(--tunnel-grid)),
			repeating-linear-gradient(to right, var(--tunnel-line) 0 1px, transparent 1px var(--tunnel-grid));
		will-change: transform;
	}

	/* fog: lines dissolve toward the far end */
	.tunnel-wall::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(var(--fog-dir), transparent 0%, color-mix(in srgb, var(--void) 55%, transparent) 45%, var(--void) 100%);
	}

	.tunnel-wall--top { --fog-dir: to bottom; }
	.tunnel-wall--bottom { --fog-dir: to top; }
	.tunnel-wall--left { --fog-dir: to right; }
	.tunnel-wall--right { --fog-dir: to left; }

	/* --- planes: viewport-sized sheets, positioned along z by the script --- */
	.tunnel-plane {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		pointer-events: none;
		will-change: transform, opacity;
		backface-visibility: hidden;
	}

	.tunnel-end {
		background:
			radial-gradient(ellipse 55% 45% at 50% 50%, color-mix(in srgb, var(--gold-dim) 45%, transparent), transparent 72%),
			var(--void);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--gold-dim) 55%, transparent);
	}

	.cinema-meander {
		position: absolute;
		bottom: 8%;
		left: 50%;
		transform: translateX(-50%);
		width: min(60vw, 480px);
		height: 14px;
		color: var(--gold-dim);
		opacity: 0.5;
	}

	.cinema-world {
		position: absolute;
		inset: 0;
		transform-style: preserve-3d;
		pointer-events: none;
	}

	/* --- category signs: small plates bolted to the tunnel's edges, each with a one-line
	   descriptor pulled from that category's event tags --- */
	.cinema-sign {
		position: absolute;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6em;
		max-width: min(70vw, 480px);
	}

	.cinema-word {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		line-height: 1;
		padding: 0.55em 0.9em;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(0.95rem, 1.8vw, 1.5rem);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--void);
		background: var(--accent);
		border-radius: 3px;
		box-shadow:
			0 6px 0 color-mix(in srgb, var(--accent) 30%, #000 70%),
			0 16px 32px rgba(0, 0, 0, 0.55),
			0 0 40px color-mix(in srgb, var(--accent) 45%, transparent),
			inset 0 1px 0 rgba(255, 255, 255, 0.3);
	}

	.cinema-word-tag {
		font-family: var(--font-body);
		font-size: 0.68rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-align: center;
		color: var(--ink-faint);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 100%;
	}

	/* technical: on the top wall, clear of the fixed nav */
	.cinema-sign[data-word='technical'] {
		top: 15%;
		left: 50%;
		transform: translate(-50%, -50%);
	}

	/* non-technical: running down the left wall */
	.cinema-sign[data-word='nontechnical'] {
		top: 50%;
		left: 8%;
		transform: translate(-50%, -50%);
	}

	.cinema-sign[data-word='nontechnical'] .cinema-word {
		writing-mode: vertical-rl;
		text-orientation: upright;
		letter-spacing: 0.02em;
	}

	.cinema-sign[data-word='nontechnical'] .cinema-word-tag {
		writing-mode: vertical-rl;
		text-orientation: mixed;
		max-height: 60vh;
	}

	/* gaming: low on the right */
	.cinema-sign[data-word='gaming'] {
		top: 90%;
		left: 76%;
		transform: translate(-50%, -50%);
	}

	/* --- the event chamber: a control panel, clickable even though its plane is not --- */
	.cinema-frame {
		position: relative;
		width: min(92vw, 1100px);
		pointer-events: auto;
	}

	.frame-panel {
		position: relative;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: linear-gradient(160deg, rgba(10, 18, 14, 0.985), rgba(6, 10, 8, 0.995));
		box-shadow: 0 30px 90px rgba(0, 0, 0, 0.55);
		padding: clamp(1.5rem, 3vw, 2.6rem);
	}

	.frame-panel::before,
	.frame-panel::after,
	.frame-panel .fp-corner {
		content: '';
		position: absolute;
		width: 14px;
		height: 14px;
		pointer-events: none;
	}

	.frame-panel::before {
		top: -1px;
		left: -1px;
		border-top: 1px solid var(--accent);
		border-left: 1px solid var(--accent);
	}

	.frame-panel::after {
		bottom: -1px;
		right: -1px;
		border-bottom: 1px solid var(--accent);
		border-right: 1px solid var(--accent);
	}

	.fp-corner.tr {
		top: -1px;
		right: -1px;
		border-top: 1px solid var(--accent);
		border-right: 1px solid var(--accent);
	}

	.fp-corner.bl {
		bottom: -1px;
		left: -1px;
		border-bottom: 1px solid var(--accent);
		border-left: 1px solid var(--accent);
	}

	.frame-head {
		display: flex;
		align-items: baseline;
		gap: 0.8rem;
		margin-bottom: 1.6rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--line);
	}

	.frame-index {
		font-family: var(--font-display);
		font-size: 0.85rem;
		letter-spacing: 0.3em;
		color: var(--accent);
	}

	.frame-head h4 {
		font-size: clamp(1.3rem, 2.6vw, 1.9rem);
		text-transform: uppercase;
	}

	.frame-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1rem;
	}

	.frame-item {
		position: relative;
		display: flex;
		align-items: flex-start;
		gap: 0.8rem;
		padding: 1rem 2.2rem 1rem 1rem;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: rgba(255, 255, 255, 0.02);
		transition: border-color 0.3s var(--ease-out), background 0.3s var(--ease-out);
	}

	.frame-item:hover,
	.frame-item:focus-visible {
		border-color: var(--accent);
		background: rgba(255, 255, 255, 0.05);
	}

	.frame-item-num {
		flex: 0 0 auto;
		font-family: var(--font-display);
		font-size: 0.7rem;
		color: var(--ink-faint);
		padding-top: 0.15rem;
	}

	.frame-item-icon {
		flex: 0 0 auto;
		width: 2.1rem;
		height: 2.1rem;
		display: grid;
		place-items: center;
		border-radius: 50%;
		border: 1px solid var(--accent);
		color: var(--accent);
		font-size: 1rem;
	}

	.frame-item-body {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.frame-item-body strong {
		font-size: 0.95rem;
		color: var(--ink);
	}

	.frame-item-desc {
		font-size: 0.7rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	:global(.frame-item-arrow) {
		position: absolute;
		top: 0.9rem;
		right: 0.9rem;
		color: var(--ink-faint);
		font-size: 0.85rem;
		transition: transform 0.3s var(--ease-out), color 0.3s var(--ease-out);
	}

	.frame-item:hover :global(.frame-item-arrow),
	.frame-item:focus-visible :global(.frame-item-arrow) {
		transform: translate(3px, -3px);
		color: var(--accent);
	}

	.frame-foot {
		display: flex;
		justify-content: center;
		margin-top: 1.8rem;
	}

	/* --- small screens and reduced motion: plain stacked layout, no tunnel, no pin --- */
	@media (max-width: 900px), (prefers-reduced-motion: reduce) {
		.cinema-stage {
			height: auto;
			overflow: visible;
		}

		.cinema-tunnel {
			position: relative;
			inset: auto;
			perspective: none;
			transform-style: flat;
		}

		.tunnel-wall,
		.tunnel-end,
		.cinema-veil {
			display: none;
		}

		.cinema-world {
			position: relative;
			inset: auto;
			transform-style: flat;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 2rem;
			padding: 4.5rem 1.25rem;
			pointer-events: auto;
		}

		.tunnel-plane {
			position: relative;
			inset: auto;
			width: 100%;
			pointer-events: auto;
			will-change: auto;
			transform: none !important;
			opacity: 1 !important;
			visibility: visible !important;
		}

		/* attribute selector so this outranks the per-sign desktop placements above */
		.cinema-sign[data-word] {
			position: relative;
			top: auto;
			left: auto;
			transform: none;
			max-width: 100%;
		}

