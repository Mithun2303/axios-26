---
import Icon from './Icon.astro';
import TimeMachine from './TimeMachine.astro';
import { events, type AxiosEvent } from '../data/events';

interface World {
	key: string;
	label: string;
	match: AxiosEvent['category'];
	accent: string;
	index: string;
	icon: string;
}

const WORLDS: World[] = [
	{ key: 'technical', label: 'Technical', match: 'Technical', accent: 'var(--gold)', index: 'I', icon: 'gear' },
	{ key: 'nontechnical', label: 'Non-Technical', match: 'Non Technical', accent: 'var(--future-2)', index: 'II', icon: 'scroll' },
	{ key: 'gaming', label: 'Gaming', match: 'Gaming', accent: 'var(--ember)', index: 'III', icon: 'joystick' },
];

// Depth layout of the tunnel (px along the z-axis, negative = away from the viewer).
// Each world owns two planes: its name sign, then its event chamber one step deeper.
// Time Machine destination chamber appears after the gaming section completes.
const STEP = 450;
const TM_DEPTH = STEP * (WORLDS.length * 2 + 1); // 450 * 7 = 3150
---

<section class="cinema" id="arenas">
	<div class="cinema-intro container" data-reveal="fade">
		<p class="eyebrow">The Directory</p>
		<h2 class="section-title">Enter the <em class="skew-heading">Arenas</em></h2>
		<p class="lede">Scroll to travel through three classes of events — each one arrives as a name, then opens into its own chamber.</p>
	</div>

	<div class="cinema-stage" id="cinema-stage">
		<!-- background tunnel: concentric perspective rings & rays (user grid design) -->
		<div class="cinema-bg" id="cinema-bg" aria-hidden="true">
			<div class="cinema-tunnel">
				<div class="tunnel-backwall" aria-hidden="true"></div>
				<div class="tunnel-rays"></div>
				{Array.from({ length: 6 }).map((_, i) => (
					<div class="tunnel-ring" style={`--i:${i}`}></div>
				))}
			</div>
			<div class="cinema-particles"></div>
			<svg class="cinema-meander" viewBox="0 0 64 16" preserveAspectRatio="xMidYMid slice">
				<pattern id="cinema-meander-pattern" width="16" height="16" patternUnits="userSpaceOnUse">
					<path d="M0 12h4V4h4v8h4V4h4" fill="none" stroke="currentColor" stroke-width="1.2" />
				</pattern>
				<rect width="64" height="16" fill="url(#cinema-meander-pattern)" />
			</svg>
		</div>

		<!-- 3D stage planes container: worlds + timemachine -->
		<div class="cinema-planes" id="cinema-planes">
			{WORLDS.map((world, i) => {
				const worldEvents = events.filter((ev) => ev.category === world.match);
				return (
					<div class="cinema-world" data-world={world.key}>
						<div class="tunnel-plane" data-plane="word" data-offset={-(STEP * (2 * i + 1))}>
							<div class="cinema-sign" data-word={world.key}>
								<h3 class="cinema-word" style={`--accent:${world.accent}`}>{world.label}</h3>
							</div>
						</div>

						<div class="tunnel-plane" data-plane="frame" data-offset={-(STEP * (2 * i + 2))}>
							<div class="cinema-frame">
								<div class="frame-panel" style={`--accent:${world.accent}`}>
									<span class="fp-corner tr" aria-hidden="true"></span>
									<span class="fp-corner bl" aria-hidden="true"></span>

									<div class="frame-head">
										<span class="frame-index">{world.index}</span>
										<h4>{world.label} Events</h4>
									</div>

									<div class="frame-grid">
										{worldEvents.map((ev, idx) => (
											<a href={`#event-${ev.key}`} class="frame-item">
												<span class="frame-item-num">{String(idx + 1).padStart(2, '0')}</span>
												<span class="frame-item-icon"><Icon name={ev.icon} /></span>
												<span class="frame-item-body">
													<strong>{ev.name}</strong>
													<span class="frame-item-desc">{ev.tag}</span>
												</span>
												<Icon name="arrow-right" class="frame-item-arrow" />
											</a>
										))}
									</div>

									<div class="frame-foot">
										<a href="#lineup" class="btn ghost frame-cta">Explore Events <Icon name="arrow-right" /></a>
									</div>
								</div>
							</div>
						</div>
					</div>
				);
			})}

			<!-- the Time Machine destination portal at the end of the tunnel (emerging from the last square) -->
			<div class="tunnel-plane tunnel-tm-plane" data-plane="timemachine" data-offset={-TM_DEPTH}>
				<div class="tunnel-tm-frame" id="tunnel-tm-frame">
					<div class="tunnel-tm-content">
						<TimeMachine />
					</div>
				</div>
			</div>
		</div>

		<!-- fades the whole scene to the void at the end, without touching the 3D context -->
		<div class="cinema-veil" aria-hidden="true"></div>
	</div>
</section>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	type PlaneKind = 'word' | 'frame' | 'timemachine';

	interface Layer {
		el: HTMLElement;
		kind: PlaneKind;
		offset: number;
		items: HTMLElement[];
	}

	const stage = document.getElementById('cinema-stage');
	const cinemaBg = stage?.querySelector<HTMLElement>('#cinema-bg') ?? null;
	const veil = stage?.querySelector<HTMLElement>('.cinema-veil') ?? null;
	const worlds = Array.from(document.querySelectorAll<HTMLElement>('.cinema-world'));
	const tmFrame = stage?.querySelector<HTMLElement>('#tunnel-tm-frame') ?? null;
	const tunnelRings = Array.from(stage?.querySelectorAll<HTMLElement>('.tunnel-ring') ?? []);

	if (stage && worlds.length > 0) {
		const mm = gsap.matchMedia();

		mm.add(
			{
				isDesktop: '(min-width: 901px)',
				reduceMotion: '(prefers-reduced-motion: reduce)',
			},
			(context) => {
				const { isDesktop, reduceMotion } = context.conditions as { isDesktop: boolean; reduceMotion: boolean };

				if (reduceMotion) return;

				if (!isDesktop) {
					// mobile in-flow reveal per world
					worlds.forEach((world) => {
						const word = world.querySelector<HTMLElement>('.cinema-word');
						const frame = world.querySelector<HTMLElement>('.cinema-frame');
						const items = world.querySelectorAll<HTMLElement>('.frame-item');
						if (!word || !frame) return;

						gsap.timeline({
							scrollTrigger: {
								trigger: world,
								start: 'top 78%',
								toggleActions: 'play none none reverse',
							},
						})
							.from(word, { autoAlpha: 0, y: 32, duration: 0.6, ease: 'power2.out' })
							.from(frame, { autoAlpha: 0, y: 32, duration: 0.6, ease: 'power2.out' }, '-=0.25')
							.from(items, { autoAlpha: 0, y: 18, duration: 0.4, stagger: 0.06, ease: 'power2.out' }, '-=0.3');
					});
					return;
				}

				// ---------------------------------------------------------------------------
				// Desktop: 3D perspective fly-through into Time Machine enlargement and scrub.
				//
				// Phase 1 (0 -> 2960): Travel down the 3D tunnel corridor past Technical,
				//   Non-Technical, and Gaming chambers. Time Machine is hidden.
				// Phase 2 (2960 -> 3700): Time Machine emerges directly from the last square
				//   (the back wall of the tunnel) at scale 0.18, and zooms forward smoothly
				//   to 1.0 (full screen), matching Screen Recording 2026-09-11 at 3.56.36 PM.
				//   The tunnel rings continue flying seamlessly and dissolve away.
				// Phase 3 (3700 -> 6700): The schedule timeline scrubs through Day 1 & Day 2.
				// ---------------------------------------------------------------------------
				const SCROLL_PX_PER_UNIT = 1.6;

				// Tunnel rings scrub parameters (from user design)
				const RING_STEP = 0.55;
				const RING_PHASE_OFFSET = 0.8;
				const TUNNEL_TRAVEL_SECONDS = 3.6;
				const updateTunnel = (progress: number) => {
					const travel = progress * TUNNEL_TRAVEL_SECONDS;
					tunnelRings.forEach((ring, i) => {
						ring.style.animationDelay = `${-(travel + RING_PHASE_OFFSET + i * RING_STEP)}s`;
					});
				};
				updateTunnel(0);

				const layers: Layer[] = Array.from(stage.querySelectorAll<HTMLElement>('.tunnel-plane')).map((el) => {
					const kind = (el.dataset.plane ?? 'word') as PlaneKind;
					return {
						el,
						kind,
						offset: parseFloat(el.dataset.offset ?? '0'),
						items: kind === 'frame' ? Array.from(el.querySelectorAll<HTMLElement>('.frame-item')) : [],
					};
				});
				const chambers = layers.filter((l) => l.kind === 'frame');
				const farthest = Math.min(...layers.map((l) => l.offset));
				const lastChamberOffset = Math.min(...chambers.map((c) => c.offset)); // -2700 (Gaming)

				const clamp01 = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
				const ramp = (z: number, from: number, to: number) => clamp01((z - from) / (to - from));

				const alphaAt = (kind: PlaneKind, z: number) => {
					const fog = 0.3 + 0.7 * ramp(z, farthest, -700);
					if (kind === 'word') return fog * ramp(z, farthest, farthest + 500) * (1 - ramp(z, 40, 420));
					return fog * ramp(z, -850, -420) * (1 - ramp(z, 40, 260));
				};

				const state = { travel: 0 };

				const enlargeStart = -lastChamberOffset + 260; // 2960 (after gaming chamber has exited)
				const enlargeEnd = enlargeStart + 740; // 3700
				const scrubDuration = 3000;
				const totalTravel = enlargeEnd + scrubDuration; // 6700

				const render = () => {
					const travel = state.travel;
					const enlargeProgress = ramp(travel, enlargeStart, enlargeEnd);
					const bgAlpha = 1 - ramp(enlargeProgress, 0.2, 0.88);

					// Continuously scrub the tunnel rings without stopping or freezing
					const tunnelTravelProgress = ramp(travel, 0, enlargeEnd);
					updateTunnel(tunnelTravelProgress);

					if (cinemaBg) {
						cinemaBg.style.opacity = String(bgAlpha);
						cinemaBg.style.visibility = bgAlpha > 0.002 ? 'visible' : 'hidden';
					}

					for (const layer of layers) {
						let z = layer.offset + travel;

						// TIME MACHINE: VISIBLE ONLY AFTER GAMING, EMERGING DIRECTLY FROM THE LAST SQUARE
						if (layer.kind === 'timemachine') {
							if (travel < enlargeStart) {
								layer.el.style.opacity = '0';
								layer.el.style.visibility = 'hidden';
								layer.el.style.pointerEvents = 'none';
								layer.el.style.transform = `translate3d(0,0,0px)`;
								continue;
							}
							// Fade in smoothly right inside that last square
							const tmAlpha = ramp(enlargeProgress, 0, 0.08);
							layer.el.style.opacity = String(tmAlpha);
							layer.el.style.visibility = tmAlpha > 0.002 ? 'visible' : 'hidden';
							layer.el.style.transform = `translate3d(0,0,0px)`;
							continue;
						}

						const alpha = alphaAt(layer.kind, z);
						const style = layer.el.style;
						style.transform = `translate3d(0,0,${z}px)`;
						style.opacity = String(alpha);
						style.visibility = alpha > 0.002 ? 'visible' : 'hidden';

						if (layer.kind === 'frame') {
							layer.items.forEach((item, i) => {
								const p = ramp(z, -720 + i * 32, -430 + i * 32);
								item.style.opacity = String(p);
								item.style.transform = `translate3d(0,${(1 - p) * 22}px,0)`;
							});
						}
					}

					// Time Machine zoom from the last square (scale 0.18 -> 1.0)
					if (tmFrame) {
						const easeProg = enlargeProgress < 0.5
							? 2 * enlargeProgress * enlargeProgress
							: 1 - Math.pow(-2 * enlargeProgress + 2, 2) / 2;
						const scale = 0.18 + 0.82 * easeProg;
						tmFrame.style.transform = `scale3d(${scale}, ${scale}, 1)`;
						tmFrame.style.pointerEvents = enlargeProgress >= 0.98 ? 'auto' : 'none';
					}

					// Schedule timeline scrub
					const scrubProgress = ramp(travel, enlargeEnd, totalTravel);
					if (typeof (window as any).__updateTimeMachine === 'function') {
						(window as any).__updateTimeMachine(scrubProgress);
					}
				};

				const tl = gsap.timeline({ onUpdate: render });
				tl.to(state, { travel: totalTravel, duration: totalTravel, ease: 'none' }, 0);

				render();

				const st = ScrollTrigger.create({
					id: 'cinema-trigger',
					animation: tl,
					trigger: stage,
					start: 'top top',
					end: () => '+=' + Math.round(tl.duration() * SCROLL_PX_PER_UNIT),
					scrub: 1,
					pin: true,
					anticipatePin: 1,
				});

				// smooth scroll for nav Schedule link
				const onScheduleClick = (e: MouseEvent) => {
					e.preventDefault();
					const cinemaSt = ScrollTrigger.getById('cinema-trigger');
					if (cinemaSt) {
						const targetScroll = cinemaSt.start + (enlargeEnd / totalTravel) * (cinemaSt.end - cinemaSt.start);
						window.scrollTo({ top: targetScroll, behavior: 'smooth' });
					}
				};
				const schedLinks = document.querySelectorAll('a[href="#schedule"]');
				schedLinks.forEach((l) => l.addEventListener('click', onScheduleClick as EventListener));

				return () => {
					for (const layer of layers) {
						layer.el.removeAttribute('style');
						layer.items.forEach((item) => item.removeAttribute('style'));
					}
					tunnelRings.forEach((r) => r.removeAttribute('style'));
					cinemaBg?.removeAttribute('style');
					veil?.removeAttribute('style');
					tmFrame?.removeAttribute('style');
					schedLinks.forEach((l) => l.removeEventListener('click', onScheduleClick as EventListener));
				};
			}
		);
	}
</script>

<style>
	.cinema {
		position: relative;
		background: var(--void);
	}

	.cinema-intro {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.1rem;
		padding: 7rem 0 3rem;
	}

	/* --- pinned stage (GSAP ScrollTrigger creates the spacer) --- */
	.cinema-stage {
		position: relative;
		height: 100vh;
		overflow: hidden;
		z-index: 2;
		background: radial-gradient(ellipse 70% 60% at 50% 40%, rgba(63, 174, 116, 0.08), transparent 65%), var(--void);
		perspective: 1400px;
		--ring-w: min(78vmin, 900px);
	}

	/* --- background tunnel grid (user design) --- */
	.cinema-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		overflow: hidden;
		transition: opacity 0.3s ease-out;
	}

	/* finite perspective-grid tunnel — fixed 6 rings, capped by solid back wall */
	.cinema-tunnel {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		perspective: 600px;
		perspective-origin: 50% 50%;
	}

	.tunnel-backwall {
		position: absolute;
		width: var(--ring-w);
		aspect-ratio: 4 / 3;
		transform: translateZ(-820px) scale(0.22);
		background: radial-gradient(ellipse at center, color-mix(in srgb, var(--gold-dim) 40%, transparent), transparent 72%);
		border: 1px solid color-mix(in srgb, var(--gold-dim) 55%, transparent);
		border-radius: 2px;
		opacity: 0.6;
	}

	.tunnel-rays {
		position: absolute;
		inset: -20%;
		background: repeating-conic-gradient(from 0deg, color-mix(in srgb, var(--gold-dim) 55%, transparent) 0deg 0.3deg, transparent 0.3deg 7.5deg);
		-webkit-mask-image: radial-gradient(circle at 50% 50%, transparent 0%, transparent 8%, #000 34%, #000 62%, transparent 92%);
		mask-image: radial-gradient(circle at 50% 50%, transparent 0%, transparent 8%, #000 34%, #000 62%, transparent 92%);
		opacity: 0.5;
	}

	.tunnel-ring {
		position: absolute;
		width: var(--ring-w);
		aspect-ratio: 4 / 3;
		border: 1px solid var(--gold-dim);
		box-shadow: 0 0 24px rgba(201, 154, 63, 0.08);
		opacity: 0;
		animation: tunnel-fly 8s linear infinite;
		animation-delay: calc(var(--i) * -1s);
		animation-play-state: paused;
	}

	@keyframes tunnel-fly {
		0% {
			transform: translateZ(-800px) scale(0.25);
			opacity: 0;
			border-color: var(--future-2);
		}
		4% {
			opacity: 0.55;
		}
		92% {
			opacity: 0.4;
			border-color: var(--gold-dim);
		}
		100% {
			transform: translateZ(280px) scale(1.7);
			opacity: 0;
			border-color: var(--gold);
		}
	}

	.cinema-particles {
		position: absolute;
		inset: 0;
		opacity: 0.5;
		background-image:
			radial-gradient(1.5px 1.5px at 12% 22%, #fff8 50%, transparent),
			radial-gradient(1.5px 1.5px at 82% 15%, #fff6 50%, transparent),
			radial-gradient(1px 1px at 32% 68%, #fff9 50%, transparent),
			radial-gradient(1.5px 1.5px at 62% 40%, #fff5 50%, transparent),
			radial-gradient(1px 1px at 92% 60%, #fff7 50%, transparent),
			radial-gradient(1.5px 1.5px at 22% 85%, #fff6 50%, transparent),
			radial-gradient(1px 1px at 48% 12%, #fff8 50%, transparent),
			radial-gradient(1.5px 1.5px at 72% 90%, #fff5 50%, transparent);
	}

	.cinema-meander {
		position: absolute;
		bottom: 6%;
		left: 50%;
		transform: translateX(-50%);
		width: min(70vw, 480px);
		height: 14px;
		color: var(--gold-dim);
		opacity: 0.4;
	}

	/* --- 3D content planes container --- */
	.cinema-planes {
		position: absolute;
		inset: 0;
		z-index: 1;
		perspective: 1000px;
		perspective-origin: 50% 50%;
		transform-style: preserve-3d;
		pointer-events: none;
	}

	.cinema-veil {
		position: absolute;
		inset: 0;
		background: var(--void);
		opacity: 0;
		pointer-events: none;
	}

	/* --- planes: viewport-sized sheets, positioned along z by the script --- */
	.tunnel-plane {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		pointer-events: none;
		will-change: transform, opacity;
		backface-visibility: hidden;
	}

	/* --- Time Machine destination portal at the end of the tunnel --- */
	.tunnel-tm-plane {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		pointer-events: none;
		will-change: transform, opacity;
		backface-visibility: hidden;
		opacity: 0;
		visibility: hidden;
	}

	.tunnel-tm-frame {
		position: relative;
		width: 100vw;
		height: 100vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		transform-origin: 50% 50%;
		will-change: transform;
		transform: translateZ(0);
		backface-visibility: hidden;
		pointer-events: none;
	}

	.tunnel-tm-content {
		position: relative;
		width: 100vw;
		height: 100vh;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: center;
		transform: translateZ(0);
		backface-visibility: hidden;
	}

	.cinema-world {
		position: absolute;
		inset: 0;
		transform-style: preserve-3d;
		pointer-events: none;
	}

	/* --- category signs: small plates bolted to the tunnel's edges --- */
	.cinema-sign {
		position: absolute;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6em;
		max-width: min(70vw, 480px);
	}

	.cinema-word {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		line-height: 1;
		padding: 0.55em 0.9em;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(0.95rem, 1.8vw, 1.5rem);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--void);
		background: var(--accent);
		border-radius: 3px;
		box-shadow:
			0 6px 0 color-mix(in srgb, var(--accent) 30%, #000 70%),
			0 16px 32px rgba(0, 0, 0, 0.55),
			0 0 40px color-mix(in srgb, var(--accent) 45%, transparent),
			inset 0 1px 0 rgba(255, 255, 255, 0.3);
	}

	.cinema-word-tag {
		font-family: var(--font-body);
		font-size: 0.68rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-align: center;
		color: var(--ink-faint);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 100%;
	}

	/* technical: top edge */
	.cinema-sign[data-word='technical'] {
		top: 15%;
		left: 50%;
		transform: translate(-50%, -50%);
	}

	/* non-technical: along left side */
	.cinema-sign[data-word='nontechnical'] {
		top: 50%;
		left: 8%;
		transform: translate(-50%, -50%);
	}

	.cinema-sign[data-word='nontechnical'] .cinema-word {
		writing-mode: vertical-rl;
		text-orientation: upright;
		letter-spacing: 0.02em;
	}

	.cinema-sign[data-word='nontechnical'] .cinema-word-tag {
		writing-mode: vertical-rl;
		text-orientation: mixed;
		max-height: 60vh;
	}

	/* gaming: lower right */
	.cinema-sign[data-word='gaming'] {
		top: 90%;
		left: 76%;
		transform: translate(-50%, -50%);
	}

	/* --- the event chamber: a control panel, clickable even though its plane is not --- */
	.cinema-frame {
		position: relative;
		width: min(92vw, 1100px);
		pointer-events: auto;
	}

	.frame-panel {
		position: relative;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: linear-gradient(160deg, rgba(10, 18, 14, 0.985), rgba(6, 10, 8, 0.995));
		box-shadow: 0 30px 90px rgba(0, 0, 0, 0.55);
		padding: clamp(1.5rem, 3vw, 2.6rem);
	}

	.frame-panel::before,
	.frame-panel::after,
	.frame-panel .fp-corner {
		content: '';
		position: absolute;
		width: 14px;
		height: 14px;
		pointer-events: none;
	}

	.frame-panel::before {
		top: -1px;
		left: -1px;
		border-top: 1px solid var(--accent);
		border-left: 1px solid var(--accent);
	}

	.frame-panel::after {
		bottom: -1px;
		right: -1px;
		border-bottom: 1px solid var(--accent);
		border-right: 1px solid var(--accent);
	}

	.fp-corner.tr {
		top: -1px;
		right: -1px;
		border-top: 1px solid var(--accent);
		border-right: 1px solid var(--accent);
	}

	.fp-corner.bl {
		bottom: -1px;
		left: -1px;
		border-bottom: 1px solid var(--accent);
