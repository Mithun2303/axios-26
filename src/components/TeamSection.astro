---
import Icon from './Icon.astro';

const GROUPS = [
	{ key: 'office', label: 'Office Bearers', access: 'Command' },
	{ key: 'tech', label: 'Technical Team', access: 'Operations' },
];

const people = [
	{ name: 'Dinesh', role: 'Secretary', group: 'office', photo: '/assets/dinesh.png' },
	{ name: 'Thithiksha', role: 'Joint Secretary', group: 'office', photo: '/assets/joint-secretary.png' },
	{ name: 'Ravi Varma', role: 'Convenor', group: 'office', photo: '/assets/convenor.png' },
	{ name: 'Ashvanth', role: 'Treasurer', group: 'office', photo: '/assets/treasurer.png' },
	{ name: 'Bhuvanesh', role: 'Executive Coordinator', group: 'office', photo: '/assets/executive-coordinator.png' },
	{ name: 'Prem Dharshan', role: 'Director', group: 'tech', photo: '/assets/prem-cropped.png' },
	{ name: 'Mithun', role: 'Coordinator', group: 'tech', photo: '/assets/mithun-cropped.png' },
	{ name: 'Ajay', role: 'Member', group: 'tech', photo: '/assets/ajay-cropped.png' },
];

const groupOf = (key: string) => GROUPS.find((g) => g.key === key)!;

const roster = people.map((p, i) => ({
	...p,
	index: i,
	code: `AX-026-${String(i + 1).padStart(3, '0')}`,
	access: groupOf(p.group).access,
	groupLabel: groupOf(p.group).label,
}));
---

<section class="architects">
	<div class="architects-bg" aria-hidden="true"></div>

	<div class="container">
		<span class="architects-corner architects-corner-l">People build<br />better timelines.</span>
		<span class="architects-corner architects-corner-r"><Icon name="sparkle" /> Beyond Time</span>

		<div class="architects-head" data-reveal="fade">
			<p class="eyebrow">Achronos '26 // Temporal Command Center</p>
			<h2 class="section-title">The <em>Architects</em></h2>
			<p class="lede">The people behind the experience.</p>
		</div>

		<div class="architects-body" data-reveal="fade">
			<div class="architects-main">
				<div class="team-tabs" role="tablist" aria-label="Filter personnel by team">
					{GROUPS.map((g, i) => (
						<button type="button" class="team-tab" data-group={g.key} aria-pressed={i === 0 ? 'true' : 'false'}>{g.label}</button>
					))}
				</div>

				<div class="medallion-grid">
					{roster.map((p) => (
						<button
							type="button"
							class:list={['medallion-card', { 'is-selected': p.index === 0 }]}
							data-group={p.group}
							data-name={p.name}
							data-role={p.role}
							data-team={p.groupLabel}
							data-access={p.access}
							data-code={p.code}
							data-photo={p.photo}
							aria-pressed={p.index === 0 ? 'true' : 'false'}
						>
							<span class="medallion-glow" aria-hidden="true"></span>
							<div class="medallion">
								<svg class="medallion-ring" viewBox="0 0 300 300" aria-hidden="true">
									<defs>
										<linearGradient id={`grid-ring-${p.index}`} x1="0%" y1="0%" x2="100%" y2="100%">
											<stop offset="0%" stop-color="#7a5430" />
											<stop offset="30%" stop-color="#e4b478" />
											<stop offset="55%" stop-color="#c99a3f" />
											<stop offset="100%" stop-color="#2f6b4a" />
										</linearGradient>
										<path id={`grid-top-${p.index}`} d="M 42,150 A 108,108 0 0 1 258,150" fill="none" />
										<path id={`grid-bottom-${p.index}`} d="M 27,150 A 123,123 0 0 0 273,150" fill="none" />
									</defs>
									<circle cx="150" cy="150" r="140" class="ring-outer" stroke={`url(#grid-ring-${p.index})`} fill="none"></circle>
									<circle cx="150" cy="150" r="116" class="ring-inner" stroke={`url(#grid-ring-${p.index})`} fill="none"></circle>
									<text class="ring-text">
										<textPath href={`#grid-top-${p.index}`} startOffset="50%" text-anchor="middle">Achronos &#183; '26</textPath>
									</text>
									<text class="ring-text">
										<textPath href={`#grid-bottom-${p.index}`} startOffset="50%" text-anchor="middle">Beyond Time</textPath>
									</text>
								</svg>
								<div class="medallion-glint" aria-hidden="true"></div>
								<div class="medallion-photo"><img src={p.photo} alt="" loading="lazy" /></div>
								<span class="medallion-laurel medallion-laurel-l" aria-hidden="true"><Icon name="laurel" /></span>
								<span class="medallion-laurel medallion-laurel-r" aria-hidden="true"><Icon name="laurel" /></span>
							</div>
							<span class="medallion-name">{p.name}</span>
							<span class="medallion-role">{p.role}</span>
						</button>
					))}
				</div>
			</div>

			<aside class="pass-card" aria-live="polite">
				<div class="pass-head">
					<div>
						<span class="pass-title">Achronos '26</span>
						<span class="pass-subtitle">Temporal Access Pass</span>
					</div>
					<span class="pass-mark" aria-hidden="true">A</span>
				</div>

				<span class="pass-id num" id="pass-id">ID // {roster[0].code}</span>

				<div class="pass-photo"><img id="pass-photo" src={roster[0].photo} alt={roster[0].name} /></div>

				<div class="pass-person">
					<span class="pass-name" id="pass-name">{roster[0].name}</span>
					<span class="pass-role" id="pass-role">{roster[0].role}</span>
				</div>

				<dl class="pass-table">
					<div>
						<dt>Team</dt>
						<dd id="pass-team">{roster[0].groupLabel}</dd>
					</div>
					<div>
						<dt>Access Level</dt>
						<dd id="pass-access">{roster[0].access}</dd>
					</div>
					<div>
						<dt>Status</dt>
						<dd><span class="pass-status-dot" aria-hidden="true"></span>Active</dd>
					</div>
					<div>
						<dt>Valid For</dt>
						<dd>Achronos '26</dd>
					</div>
				</dl>

				<div class="pass-foot">
					<Icon name="laurel" class="pass-seal" />
					<span class="pass-motto">Ideas travel through time — people carry them forward.</span>
				</div>
			</aside>
		</div>
	</div>
</section>

<script>
	const medallions = Array.from(document.querySelectorAll<HTMLButtonElement>('.medallion-card'));
	const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.team-tab'));

	const passId = document.getElementById('pass-id');
	const passPhoto = document.getElementById('pass-photo') as HTMLImageElement | null;
	const passName = document.getElementById('pass-name');
	const passRole = document.getElementById('pass-role');
	const passTeam = document.getElementById('pass-team');
	const passAccess = document.getElementById('pass-access');

	const selectPerson = (btn: HTMLButtonElement) => {
		medallions.forEach((m) => {
			m.classList.remove('is-selected');
			m.setAttribute('aria-pressed', 'false');
		});
		btn.classList.add('is-selected');
		btn.setAttribute('aria-pressed', 'true');

		const d = btn.dataset;
		if (passId) passId.textContent = `ID // ${d.code}`;
		if (passPhoto) {
			passPhoto.src = d.photo || '';
			passPhoto.alt = d.name || '';
		}
		if (passName) passName.textContent = d.name || '';
		if (passRole) passRole.textContent = d.role || '';
		if (passTeam) passTeam.textContent = d.team || '';
		if (passAccess) passAccess.textContent = d.access || '';
	};

	// auto-advance through the currently visible roster, pausing on interaction
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const CYCLE_MS = 4500;
	let autoTimer: ReturnType<typeof setInterval> | undefined;
	let paused = false;

	const advance = () => {
		if (paused) return;
		const visible = medallions.filter((m) => !m.classList.contains('is-hidden'));
		if (!visible.length) return;
		const idx = visible.findIndex((m) => m.classList.contains('is-selected'));
		selectPerson(visible[(idx + 1) % visible.length]);
	};

	const startAutoCycle = () => {
		if (reduceMotion) return;
		clearInterval(autoTimer);
		autoTimer = setInterval(advance, CYCLE_MS);
	};

	medallions.forEach((m) =>
		m.addEventListener('click', () => {
			selectPerson(m);
			startAutoCycle();
		})
	);

	tabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			tabs.forEach((t) => t.setAttribute('aria-pressed', 'false'));
			tab.setAttribute('aria-pressed', 'true');
			const g = tab.dataset.group;
			let firstVisible: HTMLButtonElement | null = null;
			medallions.forEach((m) => {
				const show = m.dataset.group === g;
				m.classList.toggle('is-hidden', !show);
				if (show && !firstVisible) firstVisible = m;
			});
			if (firstVisible) selectPerson(firstVisible);
			startAutoCycle();
		});
	});

	if (!reduceMotion) {
		const grid = document.querySelector('.medallion-grid');
		const card = document.querySelector('.pass-card');
		for (const el of [grid, card]) {
			el?.addEventListener('mouseenter', () => (paused = true));
			el?.addEventListener('mouseleave', () => (paused = false));
			el?.addEventListener('focusin', () => (paused = true));
			el?.addEventListener('focusout', () => (paused = false));
		}
		startAutoCycle();
	}
</script>

<style>
	.architects {
		position: relative;
		padding: 6rem 0;
		overflow-x: clip;
	}

	.architects-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background-image: repeating-linear-gradient(0deg, rgba(63, 174, 116, 0.05) 0 1px, transparent 1px 64px),
			repeating-linear-gradient(90deg, rgba(63, 174, 116, 0.05) 0 1px, transparent 1px 64px),
			radial-gradient(ellipse 60% 25% at 18% 10%, rgba(63, 174, 116, 0.08), transparent 60%),
			radial-gradient(ellipse 50% 25% at 86% 65%, rgba(201, 154, 63, 0.07), transparent 60%);
	}

	.architects-corner {
		position: absolute;
		z-index: 1;
		top: 0;
		display: flex;
		align-items: center;
		gap: 0.5em;
		font-size: 0.62rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		line-height: 1.5;
		color: var(--ink-faint);
	}

	.architects-corner-l {
		left: 0;
	}

	.architects-corner-r {
		right: 0;
		color: var(--gold-dim);
	}

	.architects-head {
		position: relative;
		z-index: 1;
		text-align: center;
		margin-bottom: 3rem;
	}

	.architects-body {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1.6fr 1fr;
		gap: 2.5rem;
		align-items: start;
	}

	/* --- tabs --- */
	.team-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-bottom: 2rem;
	}

	.team-tab {
		font-family: var(--font-body);
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		padding: 0.65em 1.2em;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: transparent;
		color: var(--ink-dim);
		cursor: pointer;
		transition: all 0.3s var(--ease-out);
	}

	.team-tab[aria-pressed='true'] {
		border-color: var(--future-2);
		color: var(--future);
		background: rgba(63, 174, 116, 0.1);
		box-shadow: 0 0 0 1px rgba(63, 174, 116, 0.25) inset;
	}

	/* --- medallion grid --- */
	.medallion-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
		gap: 1.6rem 1rem;
	}

	.medallion-card {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
		padding: 0;
		border: none;
		background: none;
		cursor: pointer;
		font-family: inherit;
		color: inherit;
		transition: transform 0.35s var(--ease-out);
	}

	.medallion-card.is-hidden {
		display: none;
	}

	.medallion-card:hover,
	.medallion-card:focus-visible {
		transform: translateY(-4px);
		outline: none;
	}

	.medallion {
		position: relative;
		width: clamp(120px, 15vw, 168px);
		height: clamp(120px, 15vw, 168px);
	}

	.medallion-glow {
		position: absolute;
		inset: -10%;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(110, 231, 176, 0.4), transparent 70%);
		opacity: 0;
		transform: scale(0.85);
		transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out);
		pointer-events: none;
	}

	.medallion-card.is-selected .medallion-glow {
		opacity: 1;
		transform: scale(1);
	}

	.medallion-card.is-selected .medallion {
		filter: drop-shadow(0 0 14px rgba(110, 231, 176, 0.55));
	}

	.medallion-ring {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.ring-outer {
		stroke-width: 3;
	}

	.ring-inner {
		stroke-width: 1;
		opacity: 0.7;
	}

	.ring-text {
		font-family: var(--font-display);
		font-size: 15px;
		letter-spacing: 3px;
		text-transform: uppercase;
		fill: var(--gold-bright);
	}

	.medallion-glint {
		position: absolute;
		inset: 6%;
		border-radius: 50%;
		background: radial-gradient(circle at 30% 22%, rgba(110, 231, 176, 0.32), transparent 55%);
		mix-blend-mode: screen;
		pointer-events: none;
	}

	.medallion-photo {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 74%;
		height: 74%;
		border-radius: 50%;
		overflow: hidden;
		box-shadow: inset 0 0 0 2px rgba(0, 0, 0, 0.4), inset 0 4px 12px rgba(0, 0, 0, 0.55);
	}

	.medallion-photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: sepia(0.12) saturate(0.9) contrast(1.08);
	}

	.medallion-laurel {
		position: absolute;
		bottom: 2%;
		font-size: clamp(0.9rem, 3.4vw, 1.3rem);
		color: var(--gold);
		opacity: 0.85;
	}

	.medallion-laurel-l {
		left: 3%;
	}

	.medallion-laurel-r {
		right: 3%;
		transform: scaleX(-1);
	}

	.medallion-name {
		font-family: var(--font-display);
		font-size: 0.9rem;
		text-align: center;
		color: var(--ink);
	}

	.medallion-role {
		font-size: 0.66rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-faint);
		text-align: center;
	}

	/* --- temporal access pass --- */
	.pass-card {
		position: relative;
		padding: 1.6rem;
		border: 1px solid var(--gold-dim);
		border-radius: var(--radius);
		background: linear-gradient(160deg, rgba(20, 21, 42, 0.85), rgba(8, 9, 18, 0.92));
		box-shadow: 0 20px 50px -20px rgba(0, 0, 0, 0.6);
	}

	.pass-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		padding-bottom: 0.9rem;
		margin-bottom: 0.9rem;
		border-bottom: 1px solid var(--line);
	}

	.pass-title {
		display: block;
		font-family: var(--font-display);
		font-size: 1rem;
		color: var(--gold-bright);
	}

	.pass-subtitle {
		display: block;
		margin-top: 0.15rem;
		font-size: 0.62rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.pass-mark {
		display: grid;
		place-items: center;
		width: 2.2rem;
		height: 2.2rem;
		border-radius: 50%;
		border: 1px solid var(--gold-dim);
		font-family: var(--font-display);
		color: var(--gold);
	}

	.pass-id {
		display: block;
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		color: var(--future-2);
		margin-bottom: 1rem;
	}

	.pass-photo {
		width: 100%;
		aspect-ratio: 4 / 3;
		border-radius: 8px;
		overflow: hidden;
		border: 1px solid var(--line);
		margin-bottom: 1rem;
	}

	.pass-photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: sepia(0.1) saturate(0.9) contrast(1.05);
	}

	.pass-person {
		margin-bottom: 1.2rem;
	}

	.pass-name {
		display: block;
		font-family: var(--font-display);
		font-size: 1.25rem;
		color: var(--ink);
	}

	.pass-role {
		display: block;
		margin-top: 0.2rem;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gold-bright);
	}

	.pass-table {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		margin: 0 0 1.2rem;
	}

	.pass-table > div {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 0.6rem;
		border-bottom: 1px solid var(--line);
		gap: 1rem;
	}

	.pass-table dt {
		font-size: 0.64rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.pass-table dd {
		margin: 0;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.78rem;
		color: var(--ink-dim);
	}

	.pass-status-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--future);
		box-shadow: 0 0 6px var(--future);
	}

	.pass-foot {
		display: flex;
		align-items: center;
		gap: 0.7rem;
	}

	.pass-seal {
		flex: none;
		font-size: 1.4rem;
		color: var(--gold-dim);
	}

	.pass-motto {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 0.82rem;
		color: var(--ink-faint);
		line-height: 1.4;
	}

	@media (max-width: 900px) {
		.architects-body {
			grid-template-columns: 1fr;
		}
		.architects-corner {
			display: none;
		}
		.pass-card {
			max-width: 380px;
			margin: 0 auto;
		}
	}
</style>
