---
import Icon from './Icon.astro';

const breakdown = [
	{ label: 'Technical', amount: 77500, pct: 51.7, color: 'var(--gold-bright)' },
	{ label: 'Non Technical', amount: 52500, pct: 35, color: 'var(--future-2)' },
	{ label: 'Gaming', amount: 20000, pct: 13.3, color: 'var(--ember)' },
];

let cumulative = 0;
const stops = breakdown
	.map((b) => {
		const start = cumulative;
		cumulative += b.pct;
		return `${b.color} ${start}% ${cumulative}%`;
	})
	.join(', ');
---

<section class="prizes" id="prizes">
	<div class="prize-props" aria-hidden="true">
		<div class="prop" style="--size:2.4rem; top:10%; left:6%;" data-speed="0.1"><div class="spin-slow"><Icon name="coin" /></div></div>
		<div class="prop future" style="--size:2rem; bottom:12%; right:8%;" data-speed="0.14"><div class="drift"><Icon name="trophy" /></div></div>
	</div>

	<div class="container prize-grid">
		<div class="prize-copy" data-reveal="left">
			<p class="eyebrow">Prizes</p>
			<h2 class="section-title">₹1,50,000 <em>waiting to be claimed</em></h2>
			<p class="lede">Split across ten arenas, three disciplines. Every champion's plate is funded —
				from the coder to the courtroom strategist to the keyboard warrior.</p>

			<div class="legend">
				{breakdown.map((b) => (
					<div class="legend-row">
						<span class="dot" style={`background:${b.color}`}></span>
						<span class="legend-label">{b.label}</span>
						<span class="legend-amt num" data-count={b.amount} data-count-prefix="₹">₹0</span>
					</div>
				))}
			</div>
		</div>

		<div class="prize-visual" data-reveal="scale">
			<div class="donut" style={`background: conic-gradient(${stops})`}>
				<div class="donut-hole">
					<span class="donut-total num" data-count="150000" data-count-prefix="₹">₹0</span>
					<span class="donut-label">Total Pool</span>
				</div>
			</div>
			<div class="donut-ring"></div>
		</div>
	</div>
</section>

<style>
	.prizes {
		position: relative;
		padding: 7rem 0;
		overflow: hidden;
		background: linear-gradient(180deg, var(--void), var(--deep-2) 50%, var(--void));
	}

	.prize-props {
		position: absolute;
		inset: 0;
	}

	.prize-props .prop {
		width: var(--size);
		height: var(--size);
		font-size: var(--size);
		color: var(--gold);
		opacity: 0.3;
	}

	.prize-grid {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 4rem;
		align-items: center;
	}

	.legend {
		margin-top: 2rem;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.legend-row {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		font-family: var(--font-display);
	}

	.dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		flex: none;
	}

	.legend-label {
		flex: 1;
		font-size: 0.95rem;
		color: var(--ink-dim);
		font-family: var(--font-body);
		letter-spacing: 0.04em;
	}

	.legend-amt {
		font-size: 1.15rem;
		color: var(--gold-bright);
	}

	.prize-visual {
		position: relative;
		display: grid;
		place-items: center;
	}

	.donut {
		width: min(320px, 70vw);
		height: min(320px, 70vw);
		border-radius: 50%;
		display: grid;
		place-items: center;
		animation: spin-slow 60s linear infinite;
	}

	.donut-hole {
		width: 68%;
		height: 68%;
		border-radius: 50%;
		background: var(--void);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.3rem;
		animation: spin-slow-rev 60s linear infinite;
		box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.6);
	}

	.donut-total {
		font-family: var(--font-display-deco);
		font-size: clamp(1.5rem, 4vw, 2.1rem);
		color: var(--gold-bright);
	}

	.donut-label {
		font-size: 0.68rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.donut-ring {
		position: absolute;
		inset: -18px;
		border: 1px dashed var(--line);
		border-radius: 50%;
		animation: spin-slow-rev 90s linear infinite;
	}

	@media (max-width: 820px) {
		.prize-grid {
			grid-template-columns: 1fr;
			gap: 3rem;
			text-align: center;
		}
		.legend-row {
			justify-content: center;
		}
		.prize-copy .lede {
			margin: 0 auto;
		}
	}
</style>
